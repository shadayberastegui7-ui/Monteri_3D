          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-3.2, 0, 7.5),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
