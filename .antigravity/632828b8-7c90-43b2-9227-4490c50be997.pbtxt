        }
        lines {
          text: "      // Fronds (Low-poly flat fan leaves)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      for (let f = 0; f < 6; f++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const frondAngle = (f / 6) * Math.PI * 2;"
