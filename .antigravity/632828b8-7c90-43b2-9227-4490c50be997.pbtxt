    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useRef, useState } from \'react\';\nimport * as THREE from \'three\';\nimport { Landmark, AppSettings } from \'../types\';\n\ninterface ThreeCanvasProps {\n  landmarks: Landmark[];\n  selectedLandmark: Landmark | null;\n  onSelectLandmark: (landmark: Landmark) => void;\n  settings: AppSettings;\n  isTourActive: boolean;\n  onExitTour?: () => void;\n}\n\nexport const ThreeCanvas: React.FC<ThreeCanvasProps> = ({\n  landmarks,\n  selectedLandmark,\n  onSelectLandmark,\n  settings,\n  isTourActive,\n  onExitTour,\n}) => {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const rendererRef = useRef<THREE.WebGLRenderer | null>(null);\n  const sceneRef = useRef<THREE.Scene | null>(null);\n  const cameraRef = useRef<THREE.PerspectiveCamera | null>(null);\n  const reqIdRef = useRef<number | null>(null);\n\n  const [hoveredLandmark, setHoveredLandmark] = useState<Landmark | null>(null);\n  const [wireframe, setWireframe] = useState(settings.rendererMode === \'wireframe\');\n  const [isNightMode, setIsNightMode] = useState(settings.rendererMode === \'night\');\n  const [cameraView, setCameraView] = useState<\'orbit\' | \'top\' | \'close\'>(\'orbit\');\n\n  const landmarkPinsRef = useRef<{ mesh: THREE.Mesh; landmark: Landmark }[]>([]);\n\n  useEffect(() => {\n    if (!containerRef.current) return;\n\n    // 1. Scene setup\n    const scene = new THREE.Scene();\n    sceneRef.current = scene;\n\n    const width = containerRef.current.clientWidth || window.innerWidth;\n    const height = containerRef.current.clientHeight || window.innerHeight;\n\n    // Background fog & color depending on mode\n    const isNight = settings.rendererMode === \'night\' || isNightMode;\n    const bgColor = isNight ? 0x05080c : 0x0a1c1d;\n    scene.background = new THREE.Color(bgColor);\n    scene.fog = new THREE.FogExp2(bgColor, 0.025);\n\n    // 2. Camera setup\n    const camera = new THREE.PerspectiveCamera(50, width / height, 0.1, 1000);\n    camera.position.set(0, 12, 18);\n    camera.lookAt(0, 0, 0);\n    cameraRef.current = camera;\n\n    // 3. Renderer setup\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n\n    containerRef.current.appendChild(renderer.domElement);\n    rendererRef.current = renderer;\n\n    // 4. Lighting\n    const ambientLight = new THREE.AmbientLight(\n      isNight ? 0x223344 : 0xfffaed,\n      isNight ? 0.6 : 1.2\n    );\n    scene.add(ambientLight);\n\n    const dirLight = new THREE.DirectionalLight(\n      isNight ? 0x7799cc : 0xffe6b0,\n      isNight ? 0.8 : 2.0\n    );\n    dirLight.position.set(15, 25, 10);\n    dirLight.castShadow = true;\n    dirLight.shadow.mapSize.width = 1024;\n    dirLight.shadow.mapSize.height = 1024;\n    scene.add(dirLight);\n\n    // Accent Point light for Sin\303\272 river reflections\n    const riverLight = new THREE.PointLight(0x009999, 2, 30);\n    riverLight.position.set(-2, 1, 0);\n    scene.add(riverLight);\n\n    // 5. Build Terrain & R\303\255o Sin\303\272 3D Geometry\n    const isWire = settings.rendererMode === \'wireframe\' || wireframe;\n\n    // Ground Plane (Valle del Sin\303\272)\n    const groundGeo = new THREE.PlaneGeometry(60, 60, 32, 32);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x111c1d : 0x1d362d,\n      roughness: 0.9,\n      metalness: 0.1,\n      wireframe: isWire\n    });\n    const ground = new THREE.Mesh(groundGeo, groundMat);\n    ground.rotation.x = -Math.PI / 2;\n    ground.position.y = -0.5;\n    ground.receiveShadow = true;\n    scene.add(ground);\n\n    // R\303\255o Sin\303\272 (Curved Ribbon River)\n    const riverCurve = new THREE.CatmullRomCurve3([\n      new THREE.Vector3(-15, -0.4, -20),\n      new THREE.Vector3(-8, -0.4, -10),\n      new THREE.Vector3(-3, -0.4, 0),\n      new THREE.Vector3(-2, -0.4, 10),\n      new THREE.Vector3(-6, -0.4, 20)\n    ]);\n    const riverGeo = new THREE.TubeGeometry(riverCurve, 64, 2.2, 12, false);\n    const riverMat = new THREE.MeshStandardMaterial({\n      color: 0x006666,\n      roughness: 0.2,\n      metalness: 0.8,\n      emissive: 0x002222,\n      wireframe: isWire\n    });\n    const riverMesh = new THREE.Mesh(riverGeo, riverMat);\n    scene.add(riverMesh);\n\n    // Ronda del Sin\303\272 - Green Canopy Trees Along River\n    const treeGeo = new THREE.ConeGeometry(0.5, 1.5, 6);\n    const treeMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x0f3d28 : 0x228b22,\n      roughness: 0.8\n    });\n    const trunkGeo = new THREE.CylinderGeometry(0.1, 0.1, 0.5, 6);\n    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x5c4033 });\n\n    for (let i = 0; i < 40; i++) {\n      const t = i / 40;\n      const pointOnRiver = riverCurve.getPoint(t);\n      // Offset slightly to represent riverbank park\n      const offset = (i % 2 === 0 ? 2.5 : -2.5) + (Math.random() - 0.5);\n      const treeGroup = new THREE.Group();\n\n      const trunk = new THREE.Mesh(trunkGeo, trunkMat);\n      trunk.position.y = 0.25;\n      treeGroup.add(trunk);\n\n      const foliage = new THREE.Mesh(treeGeo, treeMat);\n      foliage.position.y = 1.0;\n      treeGroup.add(foliage);\n\n      treeGroup.position.set(pointOnRiver.x + offset, -0.4, pointOnRiver.z);\n      scene.add(treeGroup);\n    }\n\n    // Low-Poly City Blocks (Monter\303\255a Urban Grid)\n    const buildingGeo = new THREE.BoxGeometry(1, 1, 1);\n    const buildingMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x2a2820 : 0xd2c7a5,\n      roughness: 0.5,\n      wireframe: isWire\n    });\n\n    // Create urban layout on right & left banks\n    for (let x = -10; x <= 10; x += 2.5) {\n      for (let z = -12; z <= 12; z += 2.5) {\n        // Skip river path\n        if (Math.abs(x + z * 0.2) < 3.5) continue;\n\n        const height = 0.8 + Math.random() * 2.5;\n        const building = new THREE.Mesh(buildingGeo, buildingMat);\n        building.scale.set(1.5, height, 1.5);\n        building.position.set(x + (Math.random() - 0.5) * 0.5, height / 2 - 0.4, z + (Math.random() - 0.5) * 0.5);\n        building.castShadow = true;\n        building.receiveShadow = true;\n        scene.add(building);\n      }\n    }\n\n    // 6. Landmark Pins (Floating glowing markers with interactive beacons)\n    landmarkPinsRef.current = [];\n    const pinGeo = new THREE.OctahedronGeometry(0.6, 0);\n\n    landmarks.forEach((landmark) => {\n      const isSelected = selectedLandmark?.id === landmark.id;\n      const pinMat = new THREE.MeshStandardMaterial({\n        color: isSelected ? 0xffc24b : 0x00a8a8,\n        emissive: isSelected ? 0xaa7700 : 0x004444,\n        roughness: 0.2,\n        metalness: 0.9,\n        wireframe: isWire\n      });\n\n      const pinMesh = new THREE.Mesh(pinGeo, pinMat);\n      pinMesh.position.set(landmark.position3D.x, landmark.position3D.y + 2.5, landmark.position3D.z);\n      scene.add(pinMesh);\n\n      // Vertical beacon light ray\n      const rayGeo = new THREE.CylinderGeometry(0.04, 0.04, 3, 8);\n      const rayMat = new THREE.MeshBasicMaterial({\n        color: isSelected ? 0xffc24b : 0x00e5e5,\n        transparent: true,\n        opacity: 0.5\n      });\n      const rayMesh = new THREE.Mesh(rayGeo, rayMat);\n      rayMesh.position.set(landmark.position3D.x, landmark.position3D.y + 1, landmark.position3D.z);\n      scene.add(rayMesh);\n\n      landmarkPinsRef.current.push({ mesh: pinMesh, landmark });\n    });\n\n    // 7. Animation Loop\n    let angle = 0;\n    const animate = () => {\n      reqIdRef.current = requestAnimationFrame(animate);\n\n      // Slow orbit if user is not locking camera\n      if (isTourActive && cameraRef.current) {\n        angle += 0.003;\n        if (selectedLandmark) {\n          // Focus on selected landmark\n          const targetX = selectedLandmark.position3D.x;\n          const targetZ = selectedLandmark.position3D.z;\n          cameraRef.current.position.x = THREE.MathUtils.lerp(cameraRef.current.position.x, targetX + Math.sin(angle) * 8, 0.05);\n          cameraRef.current.position.z = THREE.MathUtils.lerp(cameraRef.current.position.z, targetZ + Math.cos(angle) * 8, 0.05);\n          cameraRef.current.position.y = THREE.MathUtils.lerp(cameraRef.current.position.y, 6, 0.05);\n          cameraRef.current.lookAt(targetX, 0.5, targetZ);\n        } else {\n          // General overview orbit\n          cameraRef.current.position.x = Math.sin(angle) * 22;\n          cameraRef.current.position.z = Math.cos(angle) * 22;\n          cameraRef.current.lookAt(0, 0, 0);\n        }\n      }\n\n      // Pulse pin rotation\n      landmarkPinsRef.current.forEach(({ mesh }) => {\n        mesh.rotation.y += 0.02;\n      });\n\n      if (rendererRef.current && sceneRef.current && cameraRef.current) {\n        rendererRef.current.render(sceneRef.current, cameraRef.current);\n      }\n    };\n\n    animate();\n\n    // 8. Resize Handler\n    const handleResize = () => {\n      if (!containerRef.current || !rendererRef.current || !cameraRef.current) return;\n      const newW = containerRef.current.clientWidth;\n      const newH = containerRef.current.clientHeight;\n      cameraRef.current.aspect = newW / newH;\n      cameraRef.current.updateProjectionMatrix();\n      rendererRef.current.setSize(newW, newH);\n    };\n\n    window.addEventListener(\'resize\', handleResize);\n\n    return () => {\n      if (reqIdRef.current) cancelAnimationFrame(reqIdRef.current);\n      window.removeEventListener(\'resize\', handleResize);\n      if (rendererRef.current && rendererRef.current.domElement) {\n        rendererRef.current.domElement.remove();\n      }\n    };\n  }, [landmarks, selectedLandmark, isTourActive, settings.rendererMode, wireframe, isNightMode]);\n\n  // Raycaster for clicking 3D pins\n  const handleCanvasClick = (e: React.MouseEvent<HTMLDivElement>) => {\n    if (!containerRef.current || !cameraRef.current || !sceneRef.current) return;\n\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;\n    const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;\n\n    const raycaster = new THREE.Raycaster();\n    raycaster.setFromCamera(new THREE.Vector2(x, y), cameraRef.current);\n\n    const pinMeshes = landmarkPinsRef.current.map((p) => p.mesh);\n    const intersects = raycaster.intersectObjects(pinMeshes);\n\n    if (intersects.length > 0) {\n      const hitMesh = intersects[0].object as THREE.Mesh;\n      const found = landmarkPinsRef.current.find((p) => p.mesh === hitMesh);\n      if (found) {\n        onSelectLandmark(found.landmark);\n      }\n    }\n  };\n\n  return (\n    <div className=\"relative w-full h-full overflow-hidden select-none\">\n      {/* Three WebGL Canvas Container */}\n      <div\n        ref={containerRef}\n        onClick={handleCanvasClick}\n        className=\"w-full h-full cursor-grab active:cursor-grabbing\"\n      />\n\n      {/* Interactive 3D Viewport HUD Overlays when Tour is Active */}\n      {isTourActive && (\n        <>\n          {/* Top Bar HUD Info */}\n          <div className=\"absolute top-20 left-4 right-4 md:left-8 md:right-8 flex justify-between items-center pointer-events-none z-30\">\n            <div className=\"bg-[#0a0806]/80 backdrop-blur-md px-4 py-2 rounded-lg border border-[#9ff1f0]/20 flex items-center gap-3 pointer-events-auto\">\n              <span className=\"w-2 h-2 rounded-full bg-[#9ff1f0] animate-ping\" />\n              <div className=\"text-xs font-mono tracking-wider text-[#97e8e8]\">\n                Navegaci\303\263n 3D en Vivo | R\303\255o Sin\303\272\n              </div>\n            </div>\n\n            {/* Exit 3D HUD / Reset Camera */}\n            <div className=\"flex gap-2 pointer-events-auto\">\n              <button\n                onClick={() => setIsNightMode(!isNightMode)}\n                className=\"bg-[#1e1c0f]/80 hover:bg-[#006b6b] text-[#fff9eb] p-2.5 rounded-lg border border-[#bec9c8]/20 transition-all text-xs flex items-center gap-1.5\"\n                title=\"Modo D\303\255a / Noche\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">\n                  {isNightMode ? \'light_mode\' : \'dark_mode\'}\n                </span>\n              </button>\n              <button\n                onClick={() => setWireframe(!wireframe)}\n                className={`p-2.5 rounded-lg border transition-all text-xs flex items-center gap-1.5 ${\n                  wireframe\n                    ? \'bg-[#006b6b] text-white border-[#9ff1f0]\'\n                    : \'bg-[#1e1c0f]/80 hover:bg-[#006b6b] text-[#fff9eb] border-[#bec9c8]/20\'\n                }`}\n                title=\"Modo Estructura Wireframe\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">grid_4x4</span>\n              </button>\n              {onExitTour && (\n                <button\n                  onClick={onExitTour}\n                  className=\"bg-[#ba2215]/80 hover:bg-[#ba2215] text-white px-3 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider flex items-center gap-1\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">close</span>\n                  Salir\n                </button>\n              )}\n            </div>\n          </div>\n\n          {/* Left HUD: Altitude & Coordinates */}\n          <div className=\"absolute bottom-28 left-6 hidden sm:flex flex-col gap-2 pointer-events-none z-30\">\n            <div className=\"flex items-center gap-3 bg-[#0a0806]/70 backdrop-blur-md px-3 py-2 rounded border border-[#ffc24b]/30\">\n              <div className=\"w-1 h-8 bg-[#ffc24b]\" />\n              <div>\n                <div className=\"text-[10px] text-[#ffc24b] font-mono tracking-widest uppercase\">\n                  Altitud\n                </div>\n                <div className=\"text-sm font-semibold font-mono text-[#fff9eb]\">18M msnm</div>\n              </div>\n            </div>\n            <div className=\"text-[10px] text-[#e9e2ce]/70 font-mono tracking-widest bg-[#0a0806]/60 backdrop-blur-sm px-2.5 py-1 rounded\">\n              8.7479\302\260 N, 75.8814\302\260 W\n            </div>\n          </div>\n\n          {/* Bottom Selected Landmark Overlay Banner */}\n          {selectedLandmark && (\n            <div className=\"absolute bottom-24 left-1/2 -translate-x-1/2 max-w-md w-[90%] bg-[#0a0806]/90 backdrop-blur-xl border border-[#006b6b] rounded-xl p-4 text-[#fff9eb] z-40 shadow-2xl animate-fade-in-up\">\n              <div className=\"flex justify-between items-start mb-2\">\n                <div>\n                  <span className=\"text-[10px] uppercase font-bold tracking-widest text-[#97e8e8] bg-[#005151]/50 px-2 py-0.5 rounded\">\n                    {selectedLandmark.category}\n                  </span>\n                  <h3 className=\"font-cormorant text-2xl font-bold text-white mt-1\">\n                    {selectedLandmark.name}\n                  </h3>\n                  <p className=\"text-xs text-[#e9e2ce]\">{selectedLandmark.subtitle}</p>\n                </div>\n                <button\n                  onClick={() => onSelectLandmark(selectedLandmark)}\n                  className=\"text-xs text-[#ffc24b] hover:underline\"\n                >\n                  Ver detalles\n                </button>\n              </div>\n              <p className=\"text-xs text-gray-300 line-clamp-2\">{selectedLandmark.description}</p>\n            </div>\n          )}\n        </>\n      )}\n    </div>\n  );\n};\n"
    }
