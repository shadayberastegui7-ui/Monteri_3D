ordinates: true,\n30:     showCompass: true,\n31:     activeBackgroundIndex: 0,\n32:   });\n33: \n34:   const audioCtxRef = useRef<AudioContext | null>(null);\n35:   const noiseNodeRef = useRef<AudioNode | null>(null);\n36: \n37:   // Web Audio Synth for Rio Sinu Ambient Sounds\n38:   const toggleAmbientAudio = () => {\n39:     if (isAudioPlaying) {\n40:       if (audioCtxRef.current) {\n41:         audioCtxRef.current.suspend();\n42:       }\n43:       setIsAudioPlaying(false);\n44:     } else {\n45:       if (!audioCtxRef.current) {\n46:         const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;\n47:         const ctx = new AudioContextClass();\n48:         audioCtxRef.current = ctx;\n49: \n50:         // Generate pink river noise + sine breeze wave\n51:         const bufferSize = ctx.sampleRate * 2;\n52:         const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);\n53:         const output = noiseBuffer.getChannelData(0);\n54:         let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;\n55: \n56:         for (let i = 0; i < bufferSize; i++) {\n57:           const white = Math.random() * 2 - 1;\n58:           b0 = 0.99886 * b0 + white * 0.0555179;\n59:           b1 = 0.99332 * b1 + white * 0.0750759;\n60:           b2 = 0.96900 * b2 + white * 0.1538520;\n61:           b3 = 0.86650 * b3 + white * 0.3104856;\n62:           b4 = 0.55000 * b4 + white * 0.5329522;\n63:           b5 = -0.7616 * b5 - white * 0.0168980;\n64:           output[i] = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;\n65:           output[i] *= 0.04; // low ambient volume\n66:           b6 = white * 0.115926;\n67:         }\n68: \n69:         const whiteNoise = ctx.createBufferSource();\n70:         whiteNoise.buffer = noiseBuffer;\n71:         whiteNoise.loop = true;\n72: \n73:         const filter = ctx.createBiquadFilter();\n74:         filter.type = \'lowpass\';\n75:         filter.frequency.setValueAtTime(400, ctx.currentTime);\n76: \n77:         const gainNode = ctx.createGain();\n78:         gainNode.gain.setValueAtTime(0.12, ctx.currentTime);\n79: \n80:         whiteNoise.connect(filter);\n81:         filter.connect(gainNode);\n82:         gainNode.connect(ctx.destination);\n83: \n84:         whiteNoise.start();\n85:         noiseNodeRef.current = gainNode;\n86:       } else {\n87:         audioCtxRef.current.resume();\n88:       }\n89:       setIsAudioPlaying(true);\n90:     }\n91:   };\n92: \n93:   useEffect(() => {\n94:     return () => {\n95:       if (audioCtxRef.current) {\n96:         audioCtxRef.current.close();\n97:       }\n98:     };\n99:   }, []);\n100: \n101:   const handleUpdateSettings = (newSettings: Partial<AppSettings>) => {\n102:     setSettings((prev) => ({ ...prev, ...newSettings }));\n103:   };\n104: \n105:   const handleNavigateTo3D = (landmark: Landmark) => {\n106:     setSelectedLandmark(landmark);\n107:     setIsTourActive(true);\n108:     setActiveTab(\'explorer\');\n109:     setInspectLandmark(null);\n110:   };\n111: \n112:   const currentBgUrl = ALTERNATE_BACKGROUNDS[settings.activeBackgroundIndex]?.url || ALTERNATE_BACKGROUNDS[0].url;\n113: \n114:   return (\n115:     <div className=\"relative w-screen h-screen overflow-hidden bg-[#0A0806] text-[#fff9eb] font-sans-technical\">\n116:       {/* 1. Background WebGL / Photo Background Layer */}\n117:       <div className=\"absolute inset-0 w-full h-full z-0 pointer-events-none\">\n118:         <img\n119:           src={currentBgUrl}\n120:           alt=\"Monter\303\255a Background\"\n121:           className=\"absolute inset-0 w-full h-full object-cover transition-all duration-700\"\n122:           style={{\n123:             filter: isTourActive ? \'blur(2px) brightness(0.6)\' : `blur(${settings.backgroundBlur}px)`,\n124:           }}\n125:           referrerPolicy=\"no-referrer\"\n126:         />\n127:         <div className=\"absolute inset-0 bg-black/30\" />\n128:       </div>\n129: \n130:       {/* 2. Glass Overlay Gradient for Contrast */}\n131:       <div\n132:         className=\"absolute inset-0 w-full h-full glass-overlay z-10 pointer-events-none transition-all duration-500\"\n133:         style={{\n134:           background: isTourActive\n135:             ? \'linear-gradient(to bottom, rgba(0, 81, 81, 0.2), rgba(10, 8, 6, 0.75))\'\n136:             : \'linear-gradient(to bottom, rgba(0, 81, 81, 0.4), rgba(10, 8, 6, 0.88))\',\n137:         }}\n138:       />\n139: \n140:       {/* 3. Three.js 3D Canvas Layer */}\n141:       <div className={`absolute inset-0 z-15 transition-opacity duration-700 ${isTourActive ? \'opacity-100 pointer-events-auto\' : \'opacity-40 pointer-events-none\'}`}>\n142:         <ThreeCanvas\n143:           landmarks={MONTERIA_LANDMARKS}\n144:           selectedLandmark={selectedLandmark}\n145:           onSelectLandmark={(l) => setInspectLandmark(l)}\n146:           settings={settings}\n147:           isTourActive={isTourActive}\n148:           onExitTour={() => setIsTourActive(false)}\n149:         />\n150:       </div>\n151: \n152:       {/* 4. Top Header */}\n153:       <Header\n154:         activeTab={activeTab}\n155:         onTabChange={(tab) => {\n156:           setActiveTab(tab);\n157:           if (tab !== \'explorer\') setIsTourActive(false);\n158:         }}\n159:         onOpenInfo={() => setIsInfoModalOpen(false)}\n160:       />\n161: \n162:       {/* 5. Main View Content according to Active Tab */}\n163:       <main className=\"relative z-20 w-full h-full\">\n164:         {activeTab === \'explorer\' && (\n165:           <ExplorerView\n166:             onStartTour={() => setIsTourActive(true)}\n167:             landmarks={MONTERIA_LANDMARKS}\n168:             onSelectLandmark={(l) => setInspectLandmark(l)}\n169:             isTourActive={isTourActive}\n170:           />\n171:         )}\n172: \n173:         {activeTab === \'gallery\' && (\n174:           <GalleryView\n175:             landmarks={MONTERIA_LANDMARKS}\n176:             onSelectLandmark={(l) => setInspectLandmark(l)}\n177:           />\n178:         )}\n179: \n180:         {activeTab === \'map\' && (\n181:           <MapView\n182:             landmarks={MONTERIA_LANDMARKS}\n183:             onSelectLandmark={(l) => setSelectedLandmark(l)}\n184:             onNavigateTo3D={handleNavigateTo3D}\n185:           />\n186:         )}\n187: \n188:         {activeTab === \'settings\' && (\n189:           <SettingsView\n190:             settings={settings}\n191:             onUpdateSettings={handleUpdateSettings}\n192:             onToggleAmbientAudio={toggleAmbientAudio}\n193:             isAudioPlaying={isAudioPlaying}\n194:           />\n195:         )}\n196:       </main>\n197: \n198:       {/* 6. Bottom Navigation Bar */}\n199:       <BottomNav\n200:         activeTab={activeTab}\n201:         onTabChange={(tab) => {\n202:           setActiveTab(tab);\n203:           if (tab !== \'explorer\') setIsTourActive(false);\n204:         }}\n205:       />\n206: \n207:       {/* 7. Detailed Landmark Modal */}\n208:       <LandmarkModal\n209:         landmark={inspectLandmark}\n210:         onClose={() => setInspectLandmark(null)}\n211:         onNavigateTo3D={handleNavigateTo3D}\n212:       />\n213: \n214:       {/* 8. Quick Info Modal (Monter\303\255a Overview) */}\n215:       {isInfoModalOpen && (\n216:         <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fade-in-up\">\n217:           <div className=\"bg-[#0a0806] border border-[#006b6b] rounded-2xl max-w-lg w-full p-6 text-[#fff9eb] relative shadow-2xl space-y-4\">\n218:             <button\n219:               onClick={() => setIsInfoModalOpen(false)}\n220:               className=\"absolute top-4 right-4 bg-[#1e1c0f] hover:bg-[#ba2215] text-white p-2 rounded-full border border-white/20 transition-all cursor-pointer\"\n221:             >\n222:               <span className=\"material-symbols-outlined text-[18px]\">close</span>\n223:             </button>\n\n            <span className=\"text-xs uppercase font-bold tracking-widest text-[#ffc24b]\">\n              Capital Ganadera de Colombia\n            </span>\n            <h2 className=\"font-cormorant text-3xl font-bold text-white\">Monter\303\255a en 3D</h2>\n            <p className=\"text-xs text-gray-300 leading-relaxed\">\n              Monter\303\255a es la capital del departamento de C\303\263rdoba, fundada en 1777 sobre la ribera del R\303\255o Sin\303\272. Es famosa por sus paisajes fluviales, su rica gastronom\303\255a sabanera y la Ronda del Sin\303\272, el parque ecol\303\263gico lineal urbano m\303\241s grande de Am\303\251rica Latina.\n            </p>\n\n            <div className=\"bg-[#1e1c0f]/80 p-3 rounded-xl border border-[#6e7979]/20 space-y-1 text-xs font-mono text-gray-300\">\n              <div className=\"flex justify-between\">\n                <span className=\"text-gray-400\">Coordenadas:</span>\n                <span className=\"text-[#ffc24b]\">8.7479\302\260 N, 75.8814\302\260 W</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-gray-400\">Altitud:</span>\n                <span>18 msnm</span>\n              </div>\n              <div className=\"flex justify-between\">\n                <span className=\"text-gray-400\">Clima:</span>\n                <span>28\302\260C Tropical Warm</span>\n              </div>\n            </div>\n\n            <button\n              onClick={() => setIsInfoModalOpen(false)}\n              className=\"w-full bg-[#006b6b] hover:bg-[#005151] text-white py-2.5 rounded-xl font-bold text-xs uppercase tracking-wider cursor-pointer border border-[#9ff1f0]/30\"\n            >\n              Entendido\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}"
