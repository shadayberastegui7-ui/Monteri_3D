        lines {
          text: "      targetCamPosRef.current.set("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        initX + ISO_OFFSET.x * initFactor,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ISO_OFFSET.y * initFactor,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        initZ + ISO_OFFSET.z * initFactor"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
