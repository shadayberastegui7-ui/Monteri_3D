      replacement_content: "    porroGroup.position.set(5.2, -0.4, -4.2);\n    landmarks3DGroup.add(porroGroup);\n\n    // D. Villa Ol\303\255mpica - Complejo Deportivo y Recreativo (Toy-Town Sports Stadium)\n    const villaOlimpicaGroup = new THREE.Group();\n\n    // 1. Concrete & Lawn Sports Plaza Base\n    const voBaseGeo = new THREE.BoxGeometry(4.8, 0.16, 3.8);\n    const voBaseMat\350\220\203 = new THREE.MeshStandardMaterial({ color: 0x3d7b4e, roughness: 0.88, metalness: 0.02 });\n    const voBase = new THREE.Mesh(voBaseGeo, voBaseMat\350\220\203);\n    voBase.position.y = 0.08;\n    voBase.receiveShadow = true;\n    villaOlimpicaGroup.add(voBase);\n\n    // 2. Athletic Running Track (Terracotta Oval Ring Strip)\n    const trackGeo = new THREE.BoxGeometry(3.0, 0.18, 1.8);\n    const trackMat = new THREE.MeshStandardMaterial({ color: 0xba4a30, roughness: 0.85, metalness: 0.02 });\n    const trackMesh\350\277\267 = new THREE.Mesh(trackGeo, trackMat);\n    trackMesh\350\277\267.position.set(-0.7, 0.1, 0);\n    trackMesh\350\277\267.receiveShadow = true;\n    villaOlimpicaGroup.add(trackMesh\350\277\267);\n\n    // 3. Soccer Pitch (Infield Emerald Grass)\n    const pitchGeo = new THREE.BoxGeometry(2.4, 0.20, 1.2);\n    const pitchMat = new THREE.MeshStandardMaterial({ color: 0x2e7d32, roughness: 0.8, metalness: 0.02 });\n    const pitchMesh = new THREE.Mesh(pitchGeo, pitchMat);\n    pitchMesh.position.set(-0.7, 0.11, 0);\n    pitchMesh.receiveShadow = true;\n    villaOlimpicaGroup.add(pitchMesh);\n\n    // Soccer pitch center line & circle\n    const centerCircleGeo = new THREE.TorusGeometry(0.2, 0.02, 4, 16);\n    const soccerLineMat = new THREE.MeshBasicMaterial({ color: 0xffffff });\n    const centerCircle = new THREE.Mesh(centerCircleGeo, soccerLineMat);\n    centerCircle.rotation.x = Math.PI / 2;\n    centerCircle.position.set(-0.7, 0.22, 0);\n    villaOlimpicaGroup.add(centerCircle);\n\n    // Goalposts (2 mini white frames)\n    const goalGeo = new THREE.BoxGeometry(0.04, 0.16, 0.35);\n    const goalLeft = new THREE.Mesh(goalGeo, soccerLineMat);\n    goalLeft.position.set(-1.8, 0.28, 0);\n    villaOlimpicaGroup.add(goalLeft);\n\n    const goalRight\350\277\267 = new THREE.Mesh(goalGeo, soccerLineMat);\n    goalRight\350\277\267.position.set(0.4, 0.28, 0);\n    villaOlimpicaGroup.add(goalRight\350\277\267);\n\n    // 4. Main Stadium Grandstand (Tribuna Techada)\n    const grandstandGeo = new THREE.BoxGeometry(2.4, 0.35, 0.4);\n    const grandstandMat = new THREE.MeshStandardMaterial({ color: 0xdfdad2, roughness: 0.85, metalness: 0.05 });\n    const grandstand = new THREE.Mesh(grandstandGeo, grandstandMat);\n    grandstand.position.set(-0.7, 0.26, -0.9);\n    grandstand.castShadow = true;\n    grandstand.receiveShadow = true;\n    villaOlimpicaGroup.add(grandstand);\n\n    // Cantilevered Grandstand Canopy Roof\n    const canopyGeo = new THREE.BoxGeometry(2.5, 0.06, 0.6);\n    const canopyMat = new THREE.MeshStandardMaterial({ color: 0x006b6b, roughness: 0.6, metalness: 0.1 });\n    const canopy = new THREE.Mesh(canopyGeo, canopyMat);\n    canopy.position.set(-0.7, 0.55, -0.85);\n    canopy.rotation.x = Math.PI / 16;\n    canopy.castShadow = true;\n    villaOlimpicaGroup.add(canopy);\n\n    // 5. Olympic Aquatic Pool / Tennis Multicourt\n    const courtGeo = new THREE.BoxGeometry(1.2, 0.19, 1.8);\n    const courtMat = new THREE.MeshStandardMaterial({ color: 0x2b78a8, roughness: 0.6, metalness: 0.1 });\n    const courtMesh = new THREE.Mesh(courtGeo, courtMat);\n    courtMesh.position.set(1.5, 0.1, 0);\n    courtMesh.receiveShadow = true;\n    villaOlimpicaGroup.add(courtMesh);\n\n    // Tennis / Sports Net\n    const netGeo = new THREE.BoxGeometry(0.04, 0.14, 1.6);\n    const netMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.9 });\n    const net = new THREE.Mesh(netGeo, netMat);\n    net.position.set(1.5, 0.26, 0);\n    villaOlimpicaGroup.add(net);\n\n    // 6. Stadium Floodlight Towers (4 Postes de Iluminaci\303\263n en las esquinas)\n    const lightPylonGeo = new THREE.CylinderGeometry(0.03, 0.04, 1.4, 6);\n    const lightPylonMat = new THREE.MeshStandardMaterial({ color: 0xc8c3ba, metalness: 0.4, roughness: 0.5 });\n    const lampHeadGeo = new THREE.BoxGeometry(0.18, 0.1, 0.06);\n    const lampHeadMat = new THREE.MeshStandardMaterial({\n      color: 0xffffff,\n      emissive: 0xffeedd,\n      emissiveIntensity: isNight ? 1.0 : 0.4,\n    });\n\n    const pylonOffsets = [\n      { px: -1.9, pz: -0.9 },\n      { px: 0.5, pz: -0.9 },\n      { px: -1.9, pz: 0.9 },\n      { px: 0.5, pz: 0.9 },\n    ];\n\n    pylonOffsets.forEach(({ px, pz }) => {\n      const pylon = new THREE.Mesh(lightPylonGeo, lightPylonMat);\n      pylon.position.set(px, 0.7, pz);\n      pylon.castShadow = true;\n      villaOlimpicaGroup.add(pylon);\n\n      const lamp = new THREE.Mesh(lampHeadGeo, lampHeadMat);\n      lamp.position.set(px, 1.38, pz);\n      lamp.rotation.x = pz < 0 ? Math.PI / 6 : -Math.PI / 6;\n      villaOlimpicaGroup.add(lamp);\n    });\n\n    // Decorative mini entrance palm trees\n    const voPalmOffsets = [\n      { ox: 1.2, oz: 1.4 },\n      { ox: 1.8, oz: 1.4 },\n      { ox: -1.8, oz: 1.4 },\n    ];\n    const miniPalmGeo = new THREE.CylinderGeometry(0.06, 0.09, 0.8, 5);\n    const miniCrownGeo\350\220\203 = new THREE.IcosahedronGeometry(0.35, 1);\n    voPalmOffsets.forEach(({ ox, oz }) => {\n      const mTrunk = new THREE.Mesh(miniPalmGeo, treeTrunkMat);\n      mTrunk.position.set(ox, 0.4, oz);\n      mTrunk.castShadow = true;\n      villaOlimpicaGroup.add(mTrunk);\n\n      const mCrown = new THREE.Mesh(miniCrownGeo\350\220\203, foliageLimePastelMat);\n      mCrown.position.set(ox, 0.9, oz);\n      mCrown.castShadow = true;\n      villaOlimpicaGroup.add(mCrown);\n    });\n\n    villaOlimpicaGroup.position.set(7.8, -0.4, 6.4);\n    landmarks3DGroup.add(villaOlimpicaGroup);\n\n    scene.add(landmarks3DGroup);"
