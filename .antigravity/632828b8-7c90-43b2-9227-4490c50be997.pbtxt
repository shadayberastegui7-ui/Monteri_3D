        target_content: "    // 3.1. OrbitControls - Rotation strictly locked (enableRotate = false), Free Pan & Zoom enabled\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableRotate = false; // Bloquea \303\272nicamente la rotaci\303\263n manual\n    controls.enablePan = true;    // Reactiva desplazamiento y panoramizaci\303\263n\n    controls.enableZoom = true;   // Reactiva zoom in y zoom out\n    controls.screenSpacePanning = true; // Desplazamiento natural alineado con la pantalla\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.08;\n    controls.minDistance = 6;\n    controls.maxDistance = 50;\n    controls.panSpeed = 1.2;\n    controls.zoomSpeed = 1.1;\n\n    // Map primary left-click and single touch to Pan\n    controls.mouseButtons = {\n      LEFT: THREE.MOUSE.PAN,\n      MIDDLE: THREE.MOUSE.DOLLY,\n      RIGHT: THREE.MOUSE.PAN,\n    };\n    controls.touches = {\n      ONE: THREE.TOUCH.PAN,\n      TWO: THREE.TOUCH.DOLLY_PAN,\n    };\n\n    // When the user starts dragging or zooming, cancel automatic animation smoothly\n    controls.addEventListener(\'start\', () => {\n      isAnimatingRef.current = false;\n    });"
        replacement_content: "    // 3.1. OrbitControls - Full 3D exploration: Rotate, Pan & Zoom enabled\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableRotate = true; // Reactiva la rotaci\303\263n y \303\263rbita manual\n    controls.enablePan = true;    // Mantiene desplazamiento lateral y panoramizaci\303\263n\n    controls.enableZoom = true;   // Mantiene zoom in y zoom out\n    controls.screenSpacePanning = true; // Desplazamiento natural alineado con la pantalla\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.08;\n    controls.rotateSpeed = 0.8;\n    controls.panSpeed = 1.0;\n    controls.zoomSpeed = 1.1;\n    controls.minDistance = 5;\n    controls.maxDistance = 50;\n    controls.minPolarAngle = 0.05; // Evita rotar directamente en el polo norte\n    controls.maxPolarAngle = Math.PI / 2 - 0.05; // Mantiene siempre la vista por encima del suelo\n\n    // Map standard mouse buttons (Left: Rotate, Middle: Zoom, Right: Pan)\n    controls.mouseButtons = {\n      LEFT: THREE.MOUSE.ROTATE,\n      MIDDLE: THREE.MOUSE.DOLLY,\n      RIGHT: THREE.MOUSE.PAN,\n    };\n    controls.touches = {\n      ONE: THREE.TOUCH.ROTATE,\n      TWO: THREE.TOUCH.DOLLY_PAN,\n    };\n\n    // When the user starts rotating, dragging or zooming, smoothly yield automatic animation\n    controls.addEventListener(\'start\', () => {\n      isAnimatingRef.current = false;\n    });"
      }
      num_matches: 1
    }
  }
}
