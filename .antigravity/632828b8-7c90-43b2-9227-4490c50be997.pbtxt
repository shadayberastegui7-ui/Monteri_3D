        }
        lines {
          text: "          ctx.closePath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          ctx.fill();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
