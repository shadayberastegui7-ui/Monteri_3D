        }
        lines {
          text: "            -0.46 + 1.85,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            z + Math.sin(frondAngle) * 0.35"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
