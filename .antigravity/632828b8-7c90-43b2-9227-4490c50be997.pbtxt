          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    raycaster.setFromCamera(new THREE.Vector2(x, y), cameraRef.current);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
