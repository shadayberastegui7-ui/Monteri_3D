          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (let y = 16; y < 256; y += 48) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          for (let x = 24; x < 256; x += 80) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ctx.ellipse(x + (y % 48 ? 20 : 0), y, 16, 7, 0, 0, Math.PI * 2);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ctx.stroke();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
