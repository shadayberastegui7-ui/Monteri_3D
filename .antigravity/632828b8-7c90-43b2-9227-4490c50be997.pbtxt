        }
        lines {
          text: "    // 7. R\303\255o Sin\303\272 - Integrated Flat Ribbon Channel with Clean Matte Banks"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const riverPoints = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
