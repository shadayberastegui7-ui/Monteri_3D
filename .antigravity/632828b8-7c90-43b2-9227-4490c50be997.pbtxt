        }
        lines {
          text: "    const handleResize = () => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (!containerRef.current || !rendererRef.current || !cameraRef.current) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const newW = containerRef.current.clientWidth;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const newH = containerRef.current.clientHeight;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      cameraRef.current.aspect = newW / newH;"
