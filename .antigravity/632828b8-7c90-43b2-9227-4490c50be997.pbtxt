        }
        lines {
          text: "          cameraRef.current.position.x = THREE.MathUtils.lerp(cameraRef.current.position.x, targetX + Math.sin(angle) * 8, 0.05);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          cameraRef.current.position.z = THREE.MathUtils.lerp(cameraRef.current.position.z, targetZ + Math.cos(angle) * 8, 0.05);"
