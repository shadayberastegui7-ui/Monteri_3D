steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1787583186
      nanos: 9084815
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
  }
  user_input {
    user_response: "\"La app se puso muy lenta debido a la carga gr\303\241fica del nuevo estilo 3D. Por favor, aplica las siguientes optimizaciones de rendimiento en Three.js sin cambiar el dise\303\261o visual:\n\nInstanciamiento de Objetos (InstancedMesh): Agrupa todos los \303\241rboles, ventanas y elementos repetitivos utilizando InstancedMesh para reducir dr\303\241sticamente el n\303\272mero de llamadas de dibujado (draw calls).\n\nSimplificar Geometr\303\255as: Reduce el n\303\272mero de segmentos/pol\303\255gonos de los \303\241rboles (utiliza esferas de bajo nivel de detalle) y de las casas.\n\nOptimizar Sombras: Reduce la resoluci\303\263n del mapa de sombras (shadow.mapSize.width y height a 1024 o 512) y limita qu\303\251 objetos proyectan sombras.\n\nLimitar FPS y Pixel Ratio: Configura el renderizador con renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5)) para que no renderice a resoluciones 4K innecesarias en celulares o pantallas de alta densidad.\""
    items {
      text: "\"La app se puso muy lenta debido a la carga gr\303\241fica del nuevo estilo 3D. Por favor, aplica las siguientes optimizaciones de rendimiento en Three.js sin cambiar el dise\303\261o visual:\n\nInstanciamiento de Objetos (InstancedMesh): Agrupa todos los \303\241rboles, ventanas y elementos repetitivos utilizando InstancedMesh para reducir dr\303\241sticamente el n\303\272mero de llamadas de dibujado (draw calls).\n\nSimplificar Geometr\303\255as: Reduce el n\303\272mero de segmentos/pol\303\255gonos de los \303\241rboles (utiliza esferas de bajo nivel de detalle) y de las casas.\n\nOptimizar Sombras: Reduce la resoluci\303\263n del mapa de sombras (shadow.mapSize.width y height a 1024 o 512) y limita qu\303\251 objetos proyectan sombras.\n\nLimitar FPS y Pixel Ratio: Configura el renderizador con renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5)) para que no renderice a resoluciones 4K innecesarias en celulares o pantallas de alta densidad.\""
    }
  }
}
