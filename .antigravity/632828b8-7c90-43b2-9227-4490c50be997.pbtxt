        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        whiteNoise.connect(filter);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        filter.connect(gainNode);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
