        lines {
          text: "  };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const handlePointerUp = (e: React.PointerEvent<HTMLDivElement>) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const dx = Math.abs(e.clientX - pointerStartPosRef.current.x);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const dy = Math.abs(e.clientY - pointerStartPosRef.current.y);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Only fire raycast if the pointer didn\'t drag/pan more than 5 pixels"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (dx < 6 && dy < 6) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (!containerRef.current || !cameraRef.current || !sceneRef.current) return;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const rect = containerRef.current.getBoundingClientRect();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
