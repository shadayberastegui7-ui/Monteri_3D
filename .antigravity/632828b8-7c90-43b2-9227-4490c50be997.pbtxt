        }
        lines {
          text: "    // Helper: InstancedMesh batch builder"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const createInstancedMesh = ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      geo: THREE.BufferGeometry,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
