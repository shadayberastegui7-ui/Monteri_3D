    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Landmark, RouteItem } from \'../types\';\n\nexport const PROTOTYPE_BACKGROUND_IMAGE = \"https://lh3.googleusercontent.com/aida-public/AB6AXuDWg9y9Vbm7rV53_r4ddMutUYWvm_wOHz7pNmteJJhqbRL4Z9FotT7FXzIHv9YxEOqEGdFU2OcxcVhPn972cBB0p2odjgB3lsqCRR7ZdKJN-xWZCLjpNyDPCxOoKEQLxn9unYUIUVlX0q6WpAWnhzBMbmfb2xA1-VFCg50WFR7wlvgyGtvQaIm4qtP3YPbYsi06e3vtWBrrKwB5reHNb0hwrRb5DfE-sH49KiDhwtaxZfbKIM_ZTnkLpRisVVZJCCaugw\";\n\nexport const ALTERNATE_BACKGROUNDS = [\n  {\n    title: \"Vista Panor\303\241mica del R\303\255o Sin\303\272\",\n    url: PROTOTYPE_BACKGROUND_IMAGE,\n    description: \"Perspectiva general del cauce del R\303\255o Sin\303\272 y el valle de Monter\303\255a.\"\n  },\n  {\n    title: \"Atardecer en la Ronda del Sin\303\272\",\n    url: \"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1600&q=80\",\n    description: \"Luces doradas reflejadas sobre las aguas tranquilas del cauce fluvial.\"\n  },\n  {\n    title: \"Ronda Norte & Parque Lineal\",\n    url: \"https://images.unsplash.com/photo-1542224566-6e85f2e6772f?auto=format&fit=crop&w=1600&q=80\",\n    description: \"El parque lineal urbano m\303\241s grande de Am\303\251rica Latina a lo largo del Sin\303\272.\"\n  }\n];\n\nexport const MONTERIA_LANDMARKS: Landmark[] = [\n  {\n    id: \"ronda-del-sinu\",\n    name: \"Ronda del Sin\303\272\",\n    subtitle: \"Parque Lineal M\303\241s Largo de Latinoam\303\251rica\",\n    category: \"nature\",\n    coordinates: { lat: 8.7512, lng: -75.8845, alt: 18 },\n    position3D: { x: -2, y: 0, z: -1 },\n    description: \"Impresionante parque ecotur\303\255stico lineal bordeando las riberas del majestuoso R\303\255o Sin\303\272. Alberga fauna silvestre, iguanas, osos perezosos y una frondosa vegetaci\303\263n tropical.\",\n    history: \"Inaugurado a principios de la d\303\251cada de 2000, transform\303\263 la ribera del r\303\255o en el epicentro ecol\303\263gico, social y tur\303\255stico de Monter\303\255a, extendi\303\251ndose por m\303\241s de 4 kil\303\263metros.\",\n    imageUrl: \"https://images.unsplash.com/photo-1542224566-6e85f2e6772f?auto=format&fit=crop&w=1200&q=80\",\n    additionalImages: [\n      \"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80\",\n      PROTOTYPE_BACKGROUND_IMAGE\n    ],\n    audioDuration: \"2:45 min\",\n    tags: [\"Ecoturismo\", \"R\303\255o Sin\303\272\", \"Flora & Fauna\", \"Sostenibilidad\"],\n    builtYear: \"2002\",\n    locationAddress: \"Carrera 1a entre Calles 21 y 41, Monter\303\255a\",\n    rating: 4.9,\n    featured: true\n  },\n  {\n    id: \"catedral-san-jeronimo\",\n    name: \"Catedral San Jer\303\263nimo\",\n    subtitle: \"Joya Arquitect\303\263nica y Coraz\303\263n Neocl\303\241sico\",\n    category: \"architecture\",\n    coordinates: { lat: 8.7562, lng: -75.8821, alt: 22 },\n    position3D: { x: 3, y: 0.8, z: 2 },\n    description: \"Majestuoso templo cat\303\263lico ubicado en el Parque Sim\303\263n Bol\303\255var. Destaca por sus torres sim\303\251tricas, vitrales de valor patrimonial y c\303\272pulas de estilo ecl\303\251ctico neocl\303\241sico.\",\n    history: \"Construida en 1903 y finalizada a mediados del siglo XX, es el s\303\255mbolo religioso y arquitect\303\263nico m\303\241s ic\303\263nico del departamento de C\303\263rdoba.\",\n    imageUrl: \"https://images.unsplash.com/photo-1548625361-1815e9e03d3a?auto=format&fit=crop&w=1200&q=80\",\n    audioDuration: \"3:10 min\",\n    tags: [\"Patrimonio\", \"Arquitectura Neocl\303\241sica\", \"Centro Hist\303\263rico\"],\n    builtYear: \"1903 - 1956\",\n    locationAddress: \"Calle 27 # 3-16, Frente al Parque Sim\303\263n Bol\303\255var\",\n    rating: 4.8,\n    featured: true\n  },\n  {\n    id: \"muelle-turistico\",\n    name: \"Muelle Tur\303\255stico del R\303\255o Sin\303\272\",\n    subtitle: \"Embarcadero y Mirador Fluvial\",\n    category: \"nature\",\n    coordinates: { lat: 8.7490, lng: -75.8860, alt: 18 },\n    position3D: { x: -4, y: -0.2, z: -3 },\n    description: \"Punto de partida para los paseos en planchones tradicionales y lanchas motorizadas. Un espacio ideal para contemplar la brisa del Sin\303\272 y las puestas de sol.\",\n    history: \"Rescata la herencia navegable del R\303\255o Sin\303\272, el cual hist\303\263ricamente fue la principal arteria de transporte comercial hacia el Caribe colombiano.\",\n    imageUrl: PROTOTYPE_BACKGROUND_IMAGE,\n    audioDuration: \"2:15 min\",\n    tags: [\"Navegaci\303\263n Fluvial\", \"Planchones\", \"Puesta de Sol\"],\n    builtYear: \"2010\",\n    locationAddress: \"Avenida Primera con Calle 35, Monter\303\255a\",\n    rating: 4.7,\n    featured: true\n  },\n  {\n    id: \"puente-metalico\",\n    name: \"Puente Met\303\241lico Gustavo Rojas Pinilla\",\n    subtitle: \"Hito de Ingenier\303\255a y Conexi\303\263n Vial\",\n    category: \"history\",\n    coordinates: { lat: 8.7610, lng: -75.8805, alt: 25 },\n    position3D: { x: 1, y: 1.2, z: 5 },\n    description: \"Estructura de reticulado de acero que uni\303\263 por primera vez a la ciudad sobre el R\303\255o Sin\303\272, impulsando el desarrollo del noroccidente colombiano.\",\n    history: \"Inaugurado durante el gobierno del general Gustavo Rojas Pinilla en la d\303\251cada de 1950, es una obra maestra de ingenier\303\255a industrial.\",\n    imageUrl: \"https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1200&q=80\",\n    audioDuration: \"1:55 min\",\n    tags: [\"Ingenier\303\255a\", \"Patrimonio Industrial\", \"R\303\255o Sin\303\272\"],\n    builtYear: \"1956\",\n    locationAddress: \"Conexi\303\263n Calle 29 con la Margen Izquierda\",\n    rating: 4.6,\n    featured: false\n  },\n  {\n    id: \"monumento-al-porro\",\n    name: \"Monumento al Porro\",\n    subtitle: \"Homenaje al Ritmo Folcl\303\263rico Sin\303\272\",\n    category: \"culture\",\n    coordinates: { lat: 8.7420, lng: -75.8790, alt: 20 },\n    position3D: { x: 5, y: 0.3, z: -4 },\n    description: \"Escultura monumental que rinde honores a las bandas de viento y al folclor tradicional sabanero, s\303\255mbolo de la identidad musical cordobesa.\",\n    history: \"Dise\303\261ada para preservar la tradici\303\263n intangible del Porro Pelayero y Palitiao que define las festividades del Sin\303\272.\",\n    imageUrl: \"https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=1200&q=80\",\n    audioDuration: \"2:30 min\",\n    tags: [\"M\303\272sica\", \"Folclor\", \"Porro\", \"Cultura Sinuana\"],\n    builtYear: \"2015\",\n    locationAddress: \"Avenida Circunvalar con Calle 20\",\n    rating: 4.9,\n    featured: true\n  },\n  {\n    id: \"pasaje-del-sol\",\n    name: \"Pasaje del Sol & Zona Gastron\303\263mica\",\n    subtitle: \"Gastronom\303\255a y Vida Nocturna\",\n    category: \"culture\",\n    coordinates: { lat: 8.7680, lng: -75.8750, alt: 20 },\n    position3D: { x: -1, y: 0.5, z: 6 },\n    description: \"Boulevard vibrante repleto de restaurantes, caf\303\251s y cocina fusi\303\263n sabanera (mote de queso, carnes seleccionadas, suero coste\303\261o y bollos).\",\n    history: \"Evolucion\303\263 como la zona rosa y gastron\303\263mica de Monter\303\255a, reuniendo a chefs locales e internacionales.\",\n    imageUrl: \"https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1200&q=80\",\n    audioDuration: \"1:40 min\",\n    tags: [\"Gastronom\303\255a\", \"Mote de Queso\", \"Vida Nocturna\", \"Sabores del Sin\303\272\"],\n    builtYear: \"2008\",\n    locationAddress: \"Calle 62 con Carrera 7a, Zona Norte\",\n    rating: 4.8,\n    featured: false\n  }\n];\n\nexport const MONTERIA_ROUTES: RouteItem[] = [\n  {\n    id: \"ruta-rio\",\n    title: \"Ruta Verde del R\303\255o Sin\303\272\",\n    description: \"Recorrido eco-tur\303\255stico por la Ronda del Sin\303\272, muelle de planchones y parque de fauna silvestre.\",\n    distanceKm: 4.2,\n    durationMinutes: 45,\n    landmarkIds: [\"ronda-del-sinu\", \"muelle-turistico\"],\n    icon: \"directions_boat\",\n    color: \"#006b6b\"\n  },\n  {\n    id: \"ruta-historica\",\n    title: \"Ruta Hist\303\263rica y Colonial\",\n    description: \"Caminata arquitect\303\263nica por la Catedral San Jer\303\263nimo, Parque Sim\303\263n Bol\303\255var y Puente Met\303\241lico.\",\n    distanceKm: 2.8,\n    durationMinutes: 35,\n    landmarkIds: [\"catedral-san-jeronimo\", \"puente-metalico\"],\n    icon: \"account_balance\",\n    color: \"#c8921a\"\n  },\n  {\n    id: \"ruta-cultural\",\n    title: \"Ruta Cultural & Gastron\303\263mica\",\n    description: \"Sabor y m\303\272sica del Sin\303\272: Monumento al Porro y Pasaje del Sol con muestra del mejor Mote de Queso.\",\n    distanceKm: 5.1,\n    durationMinutes: 60,\n    landmarkIds: [\"monumento-al-porro\", \"pasaje-del-sol\"],\n    icon: \"restaurant\",\n    color: \"#960200\"\n  }\n];\n\nexport const MONTERIA_FACTS = {\n  title: \"Monter\303\255a - La Perla del Sin\303\272\",\n  department: \"C\303\263rdoba, Colombia\",\n  foundingDate: \"1 de mayo de 1777\",\n  founder: \"Antonio de la Torre y Miranda\",\n  population: \"Approx. 510,000 habitantes\",\n  climate: \"C\303\241lido tropical (28\302\260C - 34\302\260C)\",\n  coordinatesStr: \"8.7479\302\260 N, 75.8814\302\260 W\",\n  altitude: \"18 msnm\",\n  river: \"R\303\255o Sin\303\272 (Tercer r\303\255o m\303\241s importante del Caribe colombiano)\"\n};\n"
    }
