        }
        lines {
          text: "    window.addEventListener(\'resize\', handleResize);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return () => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
