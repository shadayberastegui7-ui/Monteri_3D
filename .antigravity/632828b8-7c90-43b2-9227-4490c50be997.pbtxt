        }
        lines {
          text: "      instanced.castShadow = castShadow;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      instanced.receiveShadow = receiveShadow;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
