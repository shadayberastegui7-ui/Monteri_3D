, 28);\n    camera.lookAt(0, 0, 0);\n    cameraRef.current = camera;\n\n    // 3. Renderer setup - Capped PixelRatio for performance\n    const renderer = new THREE.WebGLRenderer({\n      antialias: true,\n      alpha: true,\n      powerPreference: \'high-performance\'\n    });\n    renderer.setClearColor(0x000000, 0); // 100% transparent clear color\n    renderer.setSize(width, height);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n\n    containerRef.current.appendChild(renderer.domElement);\n    rendererRef.current = renderer;\n\n    // 3.1. OrbitControls - Rotation strictly locked (enableRotate = false), Free Pan & Zoom enabled\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableRotate = false; // Bloquea \303\272nicamente la rotaci\303\263n manual\n    controls.enablePan = true;    // Reactiva desplazamiento y panoramizaci\303\263n\n    controls.enableZoom = true;   // Reactiva zoom in y zoom out\n    controls.screenSpacePanning = true; // Desplazamiento natural alineado con la pantalla\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.08;\n    controls.minDistance = 6;\n    controls.maxDistance = 50;\n    controls.panSpeed = 1.2;\n    controls.zoomSpeed = 1.1;\n\n    // Map primary left-click and single touch to Pan\n    controls.mouseButtons = {\n      LEFT: THREE.MOUSE.PAN,\n      MIDDLE: THREE.MOUSE.DOLLY,\n      RIGHT: THREE.MOUSE.PAN,\n    };\n    controls.touches = {\n      ONE: THREE.TOUCH.PAN,\n      TWO: THREE.TOUCH.DOLLY_PAN,\n    };\n\n    // When the user starts dragging or zooming, cancel automatic animation smoothly\n    controls.addEventListener(\'start\', () => {\n      isAnimatingRef.current = false;\n    });\n\n    controls.target.set(0, 0, 0);\n    controlsRef.current = controls;\n\n    // Setup initial automatic focus on the first landmark (default)\n    const initialLandmark = selectedLandmark || (landmarks.length > 0 ? landmarks[0] : null);\n    if (initialLandmark) {\n      const initX = initialLandmark.position3D.x;\n      const initZ = initialLandmark.position3D.z;\n      const initFactor = 0.75;\n      targetLookAtRef.current.set(initX, 0.5, initZ);\n      targetCamPosRef.current.set(\n        initX + ISO_OFFSET.x * initFactor,\n        ISO_OFFSET.y * initFactor,\n        initZ + ISO_OFFSET.z * initFactor\n      );\n      isAnimatingRef.current = true;\n    } else {\n      targetLookAtRef.current.set(0, 0, 0);\n      targetCamPosRef.current.copy(ISO_OFFSET);\n      isAnimatingRef.current = true;\n    }"
