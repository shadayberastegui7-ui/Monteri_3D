    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    // 5. Materials Palette - Inspired by Monter\303\255a & Caribbean Colonial Architecture\n    const isWire = settings.rendererMode === \'wireframe\' || wireframe;\n\n    // Solid Opaque Architectural Materials"
      replacement_content: "    // 5. Materials Palette - Inspired by Monter\303\255a & Caribbean Colonial Architecture\n    const isWire = settings.rendererMode === \'wireframe\' || wireframe;\n\n    // Helper: Generate procedural low-poly geometric water flow texture with concentric/gentle ripple bands\n    const createLowPolyWaterTexture = () => {\n      const canvas = document.createElement(\'canvas\');\n      canvas.width = 512;\n      canvas.height = 512;\n      const ctx = canvas.getContext(\'2d\');\n      if (ctx) {\n        // Base cerulean / soft teal water\n        ctx.fillStyle = \'#2b8fa3\';\n        ctx.fillRect(0, 0, 512, 512);\n\n        // Soft lighter cerulean current bands\n        ctx.fillStyle = \'#38a3b8\';\n        for (let i = 0; i < 512; i += 32) {\n          ctx.beginPath();\n          ctx.moveTo(0, i);\n          ctx.bezierCurveTo(128, i + 14, 384, i - 14, 512, i);\n          ctx.lineTo(512, i + 16);\n          ctx.bezierCurveTo(384, i + 30, 128, i + 2, 0, i + 16);\n          ctx.closePath();\n          ctx.fill();\n        }\n\n        // Geometric ripple strokes (subtle concentric / flow rings)\n        ctx.strokeStyle = \'#5bc0d1\';\n        ctx.lineWidth = 3;\n        for (let y = 16; y < 512; y += 64) {\n          for (let x = 32; x < 512; x += 128) {\n            ctx.beginPath();\n            ctx.ellipse(x + (y % 64 ? 40 : 0), y, 22, 9, 0, 0, Math.PI * 2);\n            ctx.stroke();\n          }\n        }\n\n        // Soft highlight flecks\n        ctx.fillStyle = \'#8ee3f0\';\n        for (let j = 0; j < 40; j++) {\n          const rx = (j * 73) % 500;\n          const ry = (j * 113) % 500;\n          ctx.beginPath();\n          ctx.arc(rx, ry, 2.5, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n      const tex = new THREE.CanvasTexture(canvas);\n      tex.wrapS = THREE.RepeatWrapping;\n      tex.wrapT = THREE.RepeatWrapping;\n      tex.repeat.set(1, 8);\n      return tex;\n    };\n\n    const waterTexture = createLowPolyWaterTexture();\n\n    // River Water Material - 100% Matte, Soft Cerulean / Teal, No Mirror Shininess\n    const riverMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x1d4e5b : 0x2b8fa3,\n      map: waterTexture,\n      roughness: 0.95, // Fully matte, zero gloss glare\n      metalness: 0.0, // Non-metallic, pure clean water\n      wireframe: isWire,\n      flatShading: true, // Low-poly geometric shading\n    });\n\n    // Solid Opaque Architectural Materials"
    }
