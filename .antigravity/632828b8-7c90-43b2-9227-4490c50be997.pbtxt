        }
        lines {
          text: "      } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        rondaGroup.add(createCanopyTree(pt.x + eastOffset, pt.z, i % 5 === 0));"
