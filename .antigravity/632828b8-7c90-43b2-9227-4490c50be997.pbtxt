    replacement_chunks {
      target_content: "    // 4. Lighting\n    const ambientLight = new THREE.AmbientLight(\n      isNight ? 0x223344 : 0xfffaed,\n      isNight ? 0.6 : 1.2\n    );\n    scene.add(ambientLight);\n\n    const dirLight = new THREE.DirectionalLight(\n      isNight ? 0x7799cc : 0xffe6b0,\n      isNight ? 0.8 : 2.0\n    );\n    dirLight.position.set(15, 25, 10);\n    dirLight.castShadow = true;\n    dirLight.shadow.mapSize.width = 1024;\n    dirLight.shadow.mapSize.height = 1024;\n    scene.add(dirLight);\n\n    // Accent Point light for Sin\303\272 river reflections\n    const riverLight = new THREE.PointLight(0x009999, 2, 30);\n    riverLight.position.set(-2, 1, 0);\n    scene.add(riverLight);\n\n    // 5. Build Terrain & R\303\255o Sin\303\272 3D Geometry\n    const isWire = settings.rendererMode === \'wireframe\' || wireframe;\n\n    // Ground Plane (Valle del Sin\303\272)\n    const groundGeo = new THREE.PlaneGeometry(60, 60, 32, 32);\n    const groundMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x111c1d : 0x005151,\n      roughness: 0.9,\n      metalness: 0.1,\n      wireframe: isWire,\n      transparent: true,\n      opacity: isWire ? 0.3 : 0.15\n    });\n    const ground = new THREE.Mesh(groundGeo, groundMat);\n    ground.rotation.x = -Math.PI / 2;\n    ground.position.y = -0.5;\n    ground.receiveShadow = true;\n    scene.add(ground);\n\n    // R\303\255o Sin\303\272 (Curved Ribbon River)\n    const riverCurve = new THREE.CatmullRomCurve3([\n      new THREE.Vector3(-15, -0.4, -20),\n      new THREE.Vector3(-8, -0.4, -10),\n      new THREE.Vector3(-3, -0.4, 0),\n      new THREE.Vector3(-2, -0.4, 10),\n      new THREE.Vector3(-6, -0.4, 20)\n    ]);\n    const riverGeo = new THREE.TubeGeometry(riverCurve, 64, 2.2, 12, false);\n    const riverMat = new THREE.MeshStandardMaterial({\n      color: 0x009999,\n      roughness: 0.2,\n      metalness: 0.8,\n      emissive: 0x003333,\n      wireframe: isWire,\n      transparent: true,\n      opacity: 0.4\n    });\n    const riverMesh = new THREE.Mesh(riverGeo, riverMat);\n    scene.add(riverMesh);\n\n    // Ronda del Sin\303\272 - Green Canopy Trees Along River\n    const treeGeo = new THREE.ConeGeometry(0.5, 1.5, 6);\n    const treeMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x0f3d28 : 0x228b22,\n      roughness: 0.8,\n      transparent: true,\n      opacity: 0.5\n    });\n    const trunkGeo = new THREE.CylinderGeometry(0.1, 0.1, 0.5, 6);\n    const trunkMat = new THREE.MeshStandardMaterial({ color: 0x5c4033, transparent: true, opacity: 0.5 });\n\n    for (let i = 0; i < 40; i++) {\n      const t = i / 40;\n      const pointOnRiver = riverCurve.getPoint(t);\n      // Offset slightly to represent riverbank park\n      const offset = (i % 2 === 0 ? 2.5 : -2.5) + (Math.random() - 0.5);\n      const treeGroup = new THREE.Group();\n\n      const trunk = new THREE.Mesh(trunkGeo, trunkMat);\n      trunk.position.y = 0.25;\n      treeGroup.add(trunk);\n\n      const foliage = new THREE.Mesh(treeGeo, treeMat);\n      foliage.position.y = 1.0;\n      treeGroup.add(foliage);\n\n      treeGroup.position.set(pointOnRiver.x + offset, -0.4, pointOnRiver.z);\n      scene.add(treeGroup);\n    }\n\n    // Low-Poly City Blocks (Monter\303\255a Urban Grid)\n    const buildingGeo = new THREE.BoxGeometry(1, 1, 1);\n    const buildingMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x2a2820 : 0xd2c7a5,\n      roughness: 0.5,\n      wireframe: isWire,\n      transparent: true,\n      opacity: 0.25\n    });\n\n    // Create urban layout on right & left banks\n    for (let x = -10; x <= 10; x += 2.5) {\n      for (let z = -12; z <= 12; z += 2.5) {\n        // Skip river path\n        if (Math.abs(x + z * 0.2) < 3.5) continue;\n\n        const height = 0.8 + Math.random() * 2.5;\n        const building = new THREE.Mesh(buildingGeo, buildingMat);\n        building.scale.set(1.5, height, 1.5);\n        building.position.set(x + (Math.random() - 0.5) * 0.5, height / 2 - 0.4, z + (Math.random() - 0.5) * 0.5);\n        building.castShadow = true;\n        building.receiveShadow = true;\n        scene.add(building);\n      }\n    }"
      replacement_content: "    // 4. Lighting\n    const ambientLight = new THREE.AmbientLight(\n      isNight ? 0x1a2634 : 0xfff6e6,\n      isNight ? 0.7 : 1.3\n    );\n    scene.add(ambientLight);\n\n    // Warm Caribbean Sun Directional Light\n    const sunLight = new THREE.DirectionalLight(\n      isNight ? 0x6688aa : 0xffeed0,\n      isNight ? 0.9 : 2.2\n    );\n    sunLight.position.set(22, 32, 18);\n    sunLight.castShadow = true;\n    sunLight.shadow.mapSize.width = 2048;\n    sunLight.shadow.mapSize.height = 2048;\n    sunLight.shadow.camera.near = 0.5;\n    sunLight.shadow.camera.far = 100;\n    sunLight.shadow.camera.left = -25;\n    sunLight.shadow.camera.right = 25;\n    sunLight.shadow.camera.top = 25;\n    sunLight.shadow.camera.bottom = -25;\n    sunLight.shadow.bias = -0.0005;\n    scene.add(sunLight);\n\n    // Secondary soft fill light from sky & Sin\303\272 river reflection\n    const fillLight = new THREE.DirectionalLight(isNight ? 0x112233 : 0xaad8db, isNight ? 0.3 : 0.6);\n    fillLight.position.set(-18, 15, -15);\n    scene.add(fillLight);\n\n    // Subtle river point light\n    const riverLight = new THREE.PointLight(0x00a8a8, isNight ? 2.5 : 1.2, 28);\n    riverLight.position.set(-2, 1.2, 0);\n    scene.add(riverLight);\n\n    // 5. Materials Palette - Inspired by Monter\303\255a & Caribbean Colonial Architecture\n    const isWire = settings.rendererMode === \'wireframe\' || wireframe;\n\n    // Solid Opaque Architectural Materials\n    const wallMaterials = [\n      new THREE.MeshStandardMaterial({ color: 0xfdfaf2, roughness: 0.85, metalness: 0.05, wireframe: isWire }), // Stucco White\n      new THREE.MeshStandardMaterial({ color: 0xede2cc, roughness: 0.88, metalness: 0.05, wireframe: isWire }), // Warm Cream\n      new THREE.MeshStandardMaterial({ color: 0xe2cfad, roughness: 0.85, metalness: 0.05, wireframe: isWire }), // Sand Tone\n      new THREE.MeshStandardMaterial({ color: 0xdeb04c, roughness: 0.82, metalness: 0.05, wireframe: isWire }), // Caribbean Colonial Ochre\n      new THREE.MeshStandardMaterial({ color: 0x2e7874, roughness: 0.82, metalness: 0.05, wireframe: isWire }), // Sinu Coastal Teal\n      new THREE.MeshStandardMaterial({ color: 0xc45c3d, roughness: 0.85, metalness: 0.05, wireframe: isWire }), // Terracotta Stucco\n      new THREE.MeshStandardMaterial({ color: 0xced6dc, roughness: 0.75, metalness: 0.12, wireframe: isWire }), // Modern Tower Soft Grey\n    ];\n\n    const roofMaterials = [\n      new THREE.MeshStandardMaterial({ color: 0xc85028, roughness: 0.9, metalness: 0.05, wireframe: isWire }), // Clay Tile Orange-Red\n      new THREE.MeshStandardMaterial({ color: 0xa83818, roughness: 0.9, metalness: 0.05, wireframe: isWire }), // Burnt Terracotta\n      new THREE.MeshStandardMaterial({ color: 0xd96836, roughness: 0.88, metalness: 0.05, wireframe: isWire }), // Warm Clay Tile\n      new THREE.MeshStandardMaterial({ color: 0x8a381e, roughness: 0.92, metalness: 0.05, wireframe: isWire }), // Dark Clay\n    ];\n\n    const woodAccentMat = new THREE.MeshStandardMaterial({ color: 0x5a3820, roughness: 0.8, metalness: 0.1, wireframe: isWire });\n    const asphaltMat = new THREE.MeshStandardMaterial({ color: 0x232728, roughness: 0.95, metalness: 0.05, wireframe: isWire });\n    const sidewalkMat = new THREE.MeshStandardMaterial({ color: 0xd6cbb4, roughness: 0.9, metalness: 0.05, wireframe: isWire });\n    const bridgeGreenMat = new THREE.MeshStandardMaterial({ color: 0x186358, roughness: 0.5, metalness: 0.6, wireframe: isWire });\n\n    // Nature Materials\n    const foliageGreenMat = new THREE.MeshStandardMaterial({ color: 0x2e7d32, roughness: 0.85, metalness: 0.05, wireframe: isWire });\n    const foliageGuayacanMat = new THREE.MeshStandardMaterial({ color: 0xf5b722, roughness: 0.85, metalness: 0.05, wireframe: isWire }); // Yellow Guayac\303\241n bloom\n    const palmFrondMat = new THREE.MeshStandardMaterial({ color: 0x3b873e, roughness: 0.8, metalness: 0.05, wireframe: isWire });\n    const treeTrunkMat = new THREE.MeshStandardMaterial({ color: 0x533827, roughness: 0.9, metalness: 0.05, wireframe: isWire });\n\n    // River Water\n    const riverMat = new THREE.MeshStandardMaterial({\n      color: 0x007d7d,\n      roughness: 0.15,\n      metalness: 0.7,\n      emissive: 0x002e2e,\n      wireframe: isWire,\n    });\n\n    // 6. Base Terrain & Urban Street Grid\n    const groundGroup = new THREE.Group();\n\n    // Valle del Sin\303\272 Base Plane\n    const groundGeo = new THREE.PlaneGeometry(64, 64, 1, 1);\n    const groundBaseMat = new THREE.MeshStandardMaterial({\n      color: isNight ? 0x0f1718 : 0x486b58,\n      roughness: 0.95,\n      metalness: 0.05,\n      wireframe: isWire,\n    });\n    const ground = new THREE.Mesh(groundGeo, groundBaseMat);\n    ground.rotation.x = -Math.PI / 2;\n    ground.position.y = -0.55;\n    ground.receiveShadow = true;\n    groundGroup.add(ground);\n\n    // City Blocks Base (Manzanas)\n    const blocks: { x: number; z: number; w: number; d: number; isEast: boolean }[] = [];\n    \n    // East Bank Grid (Centro Hist\303\263rico & North Zone)\n    for (let bx = 1.5; bx <= 12; bx += 3.2) {\n      for (let bz = -14; bz <= 14; bz += 3.2) {\n        // Leave space for river corridor and central plaza\n        if (bx < 2.8 && Math.abs(bz) < 4) continue; // Plaza Sim\303\263n Bol\303\255var / Catedral clearing\n        blocks.push({ x: bx + 1.2, z: bz, w: 2.5, d: 2.5, isEast: true });\n      }\n    }\n\n    // West Bank Grid (Margen Izquierda)\n    for (let bx = -14; bx <= -4.5; bx += 3.2) {\n      for (let bz = -14; bz <= 14; bz += 3.2) {\n        if (Math.abs(bx + 7) < 1.5 && Math.abs(bz) < 2) continue;\n        blocks.push({ x: bx - 0.5, z: bz, w: 2.5, d: 2.5, isEast: false });\n      }\n    }\n\n    // Create Sidewalk foundations for blocks\n    const sidewalkGeo = new THREE.BoxGeometry(1, 0.15, 1);\n    blocks.forEach((b) => {\n      const sidewalk = new THREE.Mesh(sidewalkGeo, sidewalkMat);\n      sidewalk.scale.set(b.w + 0.3, 1, b.d + 0.3);\n      sidewalk.position.set(b.x, -0.45, b.z);\n      sidewalk.receiveShadow = true;\n      groundGroup.add(sidewalk);\n    });\n\n    scene.add(groundGroup);\n\n    // 7. R\303\255o Sin\303\272 (Meandering River Ribbon)\n    const riverCurve = new THREE.CatmullRomCurve3([\n      new THREE.Vector3(-8, -0.4, -22),\n      new THREE.Vector3(-5, -0.4, -14),\n      new THREE.Vector3(-2, -0.4, -7),\n      new THREE.Vector3(-1.2, -0.4, 0),\n      new THREE.Vector3(-3.5, -0.4, 8),\n      new THREE.Vector3(-6, -0.4, 16),\n      new THREE.Vector3(-9, -0.4, 22),\n    ]);\n\n    const riverGeo = new THREE.TubeGeometry(riverCurve, 80, 2.8, 16, false);\n    const riverMesh = new THREE.Mesh(riverGeo, riverMat);\n    riverMesh.receiveShadow = true;\n    scene.add(riverMesh);\n\n    // 8. Ronda del Sin\303\272 (Green Linear Park along Riverbank)\n    const rondaGroup = new THREE.Group();\n\n    // Helper: Low-Poly Palm Tree\n    const createPalmTree = (x: number, z: number) => {\n      const palmGroup = new THREE.Group();\n      const trunkGeo = new THREE.CylinderGeometry(0.08, 0.14, 1.8, 5);\n      const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n      trunk.position.y = 0.9;\n      trunk.rotation.z = (Math.random() - 0.5) * 0.15;\n      trunk.castShadow = true;\n      palmGroup.add(trunk);\n\n      // Fronds (Low-poly flat fan leaves)\n      for (let f = 0; f < 6; f++) {\n        const frondAngle = (f / 6) * Math.PI * 2;\n        const frondGeo = new THREE.ConeGeometry(0.35, 1.1, 4);\n        const frond = new THREE.Mesh(frondGeo, palmFrondMat);\n        frond.position.set(Math.cos(frondAngle) * 0.3, 1.8, Math.sin(frondAngle) * 0.3);\n        frond.rotation.x = Math.PI / 2.8;\n        frond.rotation.y = frondAngle;\n        frond.scale.set(1, 0.2, 1);\n        frond.castShadow = true;\n        palmGroup.add(frond);\n      }\n      palmGroup.position.set(x, -0.45, z);\n      return palmGroup;\n    };\n\n    // Helper: Low-Poly Tropical Guayac\303\241n / Canopy Tree\n    const createCanopyTree = (x: number, z: number, isGuayacan = false) => {\n      const treeGroup = new THREE.Group();\n      const trunkGeo = new THREE.CylinderGeometry(0.12, 0.18, 1.2, 5);\n      const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n      trunk.position.y = 0.6;\n      trunk.castShadow = true;\n      treeGroup.add(trunk);\n\n      const crownGeo = new THREE.DodecahedronGeometry(0.7, 0);\n      const crownMat = isGuayacan ? foliageGuayacanMat : foliageGreenMat;\n      const crown = new THREE.Mesh(crownGeo, crownMat);\n      crown.position.y = 1.6;\n      crown.scale.set(1.1, 0.9, 1.1);\n      crown.castShadow = true;\n      treeGroup.add(crown);\n\n      treeGroup.position.set(x, -0.45, z);\n      return treeGroup;\n    };\n\n    // Populate Ronda del Sin\303\272 along river curves\n    for (let i = 0; i <= 48; i++) {\n      const t = i / 48;\n      const pt = riverCurve.getPoint(t);\n      // East riverbank park (Ronda del Sin\303\272)\n      const eastOffset = 3.2 + (i % 3 === 0 ? 0.6 : -0.3);\n      if (i % 2 === 0) {\n        rondaGroup.add(createPalmTree(pt.x + eastOffset, pt.z));\n      } else {\n        rondaGroup.add(createCanopyTree(pt.x + eastOffset, pt.z, i % 5 === 0));\n      }\n\n      // West riverbank vegetation\n      if (i % 3 === 0) {\n        const westOffset = -3.2 + (Math.random() - 0.5) * 0.4;\n        rondaGroup.add(createCanopyTree(pt.x + westOffset, pt.z, i % 7 === 0));\n      }\n    }\n    scene.add(rondaGroup);\n\n    // 9. Procedural Low-Poly Buildings with Monter\303\255a Urban Diversity\n    const cityGroup = new THREE.Group();\n\n    // Helper to generate a single low-poly building with clay tile roof or rooftop terrace\n    const createBuilding = (\n      x: number,\n      z: number,\n      width: number,\n      depth: number,\n      floors: number,\n      style: \'colonial\' | \'townhouse\' | \'midrise\'\n    ) => {\n      const bGroup = new THREE.Group();\n      const floorHeight = 0.65;\n      const totalH = floors * floorHeight;\n\n      const wallMat = wallMaterials[Math.floor(Math.random() * wallMaterials.length)];\n      const roofMat = roofMaterials[Math.floor(Math.random() * roofMaterials.length)];\n\n      // 1. Base Wall Body\n      const bodyGeo = new THREE.BoxGeometry(width, totalH, depth);\n      const bodyMesh = new THREE.Mesh(bodyGeo, wallMat);\n      bodyMesh.position.y = totalH / 2;\n      bodyMesh.castShadow = true;\n      bodyMesh.receiveShadow = true;\n      bGroup.add(bodyMesh);\n\n      // 2. Windows & Balconies (Subtle Low-poly Insets/Accents)\n      if (floors >= 2 && !isWire) {\n        for (let f = 1; f < floors; f++) {\n          const balconyGeo = new THREE.BoxGeometry(width * 0.7, 0.12, 0.15);\n          const balcony = new THREE.Mesh(balconyGeo, woodAccentMat);\n          balcony.position.set(0, f * floorHeight, depth / 2 + 0.08);\n          balcony.castShadow = true;\n          bGroup.add(balcony);\n        }\n      }\n\n      // 3. Roof Style\n      if (style === \'colonial\') {\n        // Traditional 4-sided pitched clay roof (Pyramid Hip Roof)\n        const roofHeight = 0.55 + width * 0.2;\n        const roofGeo = new THREE.ConeGeometry(Math.max(width, depth) * 0.78, roofHeight, 4);\n        const roofMesh = new THREE.Mesh(roofGeo, roofMat);\n        roofMesh.position.y = totalH + roofHeight / 2 - 0.05;\n        roofMesh.rotation.y = Math.PI / 4;\n        roofMesh.scale.set(width / Math.max(width, depth), 1, depth / Math.max(width, depth));\n        roofMesh.castShadow = true;\n        roofMesh.receiveShadow = true;\n        bGroup.add(roofMesh);\n      } else if (style === \'townhouse\') {\n        // Flat Roof with Parapet Perimeter + Elevated Water Tank (Tanque de Agua)\n        const parapetGeo = new THREE.BoxGeometry(width, 0.15, depth);\n        const parapet = new THREE.Mesh(parapetGeo, roofMat);\n        parapet.position.y = totalH + 0.075;\n        parapet.castShadow = true;\n        bGroup.add(parapet);\n\n        // Water tank / rooftop terrace box\n        const tankGeo = new THREE.CylinderGeometry(0.2, 0.2, 0.3, 6);\n        const tank = new THREE.Mesh(tankGeo, woodAccentMat);\n        tank.position.set((Math.random() - 0.5) * (width * 0.4), totalH + 0.25, (Math.random() - 0.5) * (depth * 0.4));\n        tank.castShadow = true;\n        bGroup.add(tank);\n      } else {\n        // Midrise Stepped Roof\n        const penthouseW = width * 0.65;\n        const penthouseD = depth * 0.65;\n        const penthouseH = 0.5;\n        const pentGeo = new THREE.BoxGeometry(penthouseW, penthouseH, penthouseD);\n        const pentMesh = new THREE.Mesh(pentGeo, wallMaterials[0]);\n        pentMesh.position.y = totalH + penthouseH / 2;\n        pentMesh.castShadow = true;\n        bGroup.add(pentMesh);\n\n        const topCapGeo = new THREE.BoxGeometry(penthouseW + 0.1, 0.1, penthouseD + 0.1);\n        const topCap = new THREE.Mesh(topCapGeo, roofMat);\n        topCap.position.y = totalH + penthouseH + 0.05;\n        bGroup.add(topCap);\n      }\n\n      bGroup.position.set(x, -0.38, z);\n      return bGroup;\n    };\n\n    // Populate each urban block with diverse low-poly houses & buildings\n    blocks.forEach((block) => {\n      const halfW = block.w / 2;\n      const halfD = block.d / 2;\n\n      // Subdivide block into 2 or 4 lots\n      const subdivisions = [\n        { ox: -halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: -halfW * 0.5, oz: halfD * 0.5 },\n        { ox: halfW * 0.5, oz: halfD * 0.5 },\n      ];\n\n      subdivisions.forEach((sub, idx) => {\n        const bX = block.x + sub.ox;\n        const bZ = block.z + sub.oz;\n        const lotW = 0.9 + Math.random() * 0.25;\n        const lotD = 0.9 + Math.random() * 0.25;\n\n        let floors = 1;\n        let style: \'colonial\' | \'townhouse\' | \'midrise\' = \'colonial\';\n\n        // Downtown (East Bank near center) has some taller 3-6 floor buildings\n        const distFromCenter = Math.sqrt(bX * bX + bZ * bZ);\n        if (block.isEast && distFromCenter < 9 && idx === 0 && Math.random() > 0.45) {\n          floors = Math.floor(3 + Math.random() * 3);\n          style = \'midrise\';\n        } else if (Math.random() > 0.4) {\n          floors = 2;\n          style = Math.random() > 0.5 ? \'colonial\' : \'townhouse\';\n        } else {\n          floors = 1;\n          style = \'colonial\';\n        }\n\n        cityGroup.add(createBuilding(bX, bZ, lotW, lotD, floors, style));\n      });\n    });\n\n    scene.add(cityGroup);\n\n    // 10. Iconic Monter\303\255a Landmark Models (Crafted in Low-Poly)\n    const landmarks3DGroup = new THREE.Group();\n\n    // A. Catedral San Jer\303\263nimo (Double Tower Neoclassical Cathedral in Plaza)\n    const catGroup = new THREE.Group();\n    const catWallMat = wallMaterials[0]; // Pure white stucco\n    const catRoofMat = roofMaterials[0]; // Terracotta clay roof\n    const catDomeMat = new THREE.MeshStandardMaterial({ color: 0xdeb04c, roughness: 0.6, metalness: 0.3 }); // Golden dome\n\n    // Central Nave\n    const naveGeo = new THREE.BoxGeometry(2.4, 2.2, 3.8);\n    const nave = new THREE.Mesh(naveGeo, catWallMat);\n    nave.position.y = 1.1;\n    nave.castShadow = true;\n    nave.receiveShadow = true;\n    catGroup.add(nave);\n\n    // Nave Gabled Roof\n    const naveRoofGeo = new THREE.ConeGeometry(2.2, 1.2, 4);\n    const naveRoof = new THREE.Mesh(naveRoofGeo, catRoofMat);\n    naveRoof.position.set(0, 2.8, 0);\n    naveRoof.rotation.y = Math.PI / 4;\n    naveRoof.scale.set(1, 1, 1.6);\n    naveRoof.castShadow = true;\n    catGroup.add(naveRoof);\n\n    // Twin Bell Towers (Front Facade)\n    [-1.0, 1.0].forEach((tx) => {\n      const towerBaseGeo = new THREE.BoxGeometry(0.9, 3.8, 0.9);\n      const tower = new THREE.Mesh(towerBaseGeo, catWallMat);\n      tower.position.set(tx, 1.9, 1.8);\n      tower.castShadow = true;\n      catGroup.add(tower);\n\n      // Tower Spire Cupola\n      const spireGeo = new THREE.ConeGeometry(0.65, 1.2, 6);\n      const spire = new THREE.Mesh(spireGeo, catDomeMat);\n      spire.position.set(tx, 4.4, 1.8);\n      spire.castShadow = true;\n      catGroup.add(spire);\n    });\n\n    // Central Cupola / Dome\n    const domeGeo = new THREE.SphereGeometry(0.7, 8, 6, 0, Math.PI * 2, 0, Math.PI / 2);\n    const dome = new THREE.Mesh(domeGeo, catDomeMat);\n    dome.position.set(0, 3.2, -0.8);\n    dome.castShadow = true;\n    catGroup.add(dome);\n\n    catGroup.position.set(3.2, -0.4, 2.0);\n    landmarks3DGroup.add(catGroup);\n\n    // B. Puente Met\303\241lico Gustavo Rojas Pinilla (Steel Arch Truss Bridge Spanning Sin\303\272)\n    const bridgeGroup = new THREE.Group();\n    const bridgeDeckGeo = new THREE.BoxGeometry(1.2, 0.2, 7.5);\n    const bridgeDeck = new THREE.Mesh(bridgeDeckGeo, asphaltMat);\n    bridgeDeck.position.set(0, 1.2, 0);\n    bridgeDeck.castShadow = true;\n    bridgeGroup.add(bridgeDeck);\n\n    // Steel Truss Arches (Low-Poly Steel Lattice)\n    [-0.6, 0.6].forEach((sideX) => {\n      const archCurve = new THREE.QuadraticBezierCurve3(\n        new THREE.Vector3(sideX, 1.2, -3.6),\n        new THREE.Vector3(sideX, 2.8, 0),\n        new THREE.Vector3(sideX, 1.2, 3.6)\n      );\n      const archGeo = new THREE.TubeGeometry(archCurve, 16, 0.08, 6, false);\n      const archMesh = new THREE.Mesh(archGeo, bridgeGreenMat);\n      archMesh.castShadow = true;\n      bridgeGroup.add(archMesh);\n\n      // Vertical suspension posts\n      for (let p = -3; p <= 3; p += 0.8) {\n        const postH = 0.3 + (1 - Math.abs(p) / 3.6) * 1.2;\n        const postGeo = new THREE.CylinderGeometry(0.03, 0.03, postH, 4);\n        const post = new THREE.Mesh(postGeo, bridgeGreenMat);\n        post.position.set(sideX, 1.2 + postH / 2, p);\n        bridgeGroup.add(post);\n      }\n    });\n\n    // Bridge Concrete Piers in Water\n    const pierGeo = new THREE.BoxGeometry(1.8, 1.8, 0.6);\n    [-2.2, 2.2].forEach((pz) => {\n      const pier = new THREE.Mesh(pierGeo, sidewalkMat);\n      pier.position.set(0, 0.3, pz);\n      pier.castShadow = true;\n      bridgeGroup.add(pier);\n    });\n\n    bridgeGroup.position.set(-2.0, -0.4, 5.2);\n    bridgeGroup.rotation.y = -Math.PI / 16;\n    landmarks3DGroup.add(bridgeGroup);\n\n    // C. Muelle Tur\303\255stico & Planchones Tradicionales\n    const muelleGroup = new THREE.Group();\n    // Wooden Boardwalk Pier\n    const pierBoardGeo = new THREE.BoxGeometry(2.4, 0.15, 1.2);\n    const pierBoard = new THREE.Mesh(pierBoardGeo, woodAccentMat);\n    pierBoard.position.set(0, 0.1, 0);\n    pierBoard.castShadow = true;\n    muelleGroup.add(pierBoard);\n\n    // Planch\303\263n del Sin\303\272 (Traditional wooden cable boat with canvas roof)\n    const planchonBoatGeo = new THREE.BoxGeometry(1.4, 0.25, 0.8);\n    const planchonBoat = new THREE.Mesh(planchonBoatGeo, woodAccentMat);\n    planchonBoat.position.set(-1.6, -0.05, 0.3);\n    planchonBoat.castShadow = true;\n    muelleGroup.add(planchonBoat);\n\n    const canopyGeo = new THREE.BoxGeometry(1.4, 0.05, 0.8);\n    const canopyMat = new THREE.MeshStandardMaterial({ color: 0xfffaea, roughness: 0.9 });\n    const canopy = new THREE.Mesh(canopyGeo, canopyMat);\n    canopy.position.set(-1.6, 0.45, 0.3);\n    canopy.castShadow = true;\n    muelleGroup.add(canopy);\n\n    muelleGroup.position.set(-3.8, -0.4, -3.2);\n    landmarks3DGroup.add(muelleGroup);\n\n    // D. Monumento al Porro (Roundabout with Musical Low-Poly Brass Sculpture)\n    const porroGroup = new THREE.Group();\n    const roundaboutGeo = new THREE.CylinderGeometry(1.2, 1.3, 0.2, 16);\n    const roundabout = new THREE.Mesh(roundaboutGeo, sidewalkMat);\n    roundabout.position.y = 0.1;\n    roundabout.receiveShadow = true;\n    porroGroup.add(roundabout);\n\n    // Spiral Brass Horn / Porro notes abstract sculpture\n    const brassMat = new THREE.MeshStandardMaterial({ color: 0xe5a928, roughness: 0.3, metalness: 0.85 });\n    const hornGeo = new THREE.TorusGeometry(0.6, 0.12, 8, 16, Math.PI * 1.5);\n    const horn = new THREE.Mesh(hornGeo, brassMat);\n    horn.position.set(0, 0.9, 0);\n    horn.rotation.x = Math.PI / 3;\n    horn.castShadow = true;\n    porroGroup.add(horn);\n\n    const baseColumnGeo = new THREE.CylinderGeometry(0.18, 0.25, 0.8, 8);\n    const baseColumn = new THREE.Mesh(baseColumnGeo, catWallMat);\n    baseColumn.position.y = 0.4;\n    porroGroup.add(baseColumn);\n\n    porroGroup.position.set(5.2, -0.4, -4.2);\n    landmarks3DGroup.add(porroGroup);\n\n    scene.add(landmarks3DGroup);"
    }
