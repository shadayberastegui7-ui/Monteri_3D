        lines {
          text: "    // 7. R\303\255o Sin\303\272 - Integrated Flat Ribbon Channel with Clean Matte Banks (Simplified Geometry)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const riverPoints = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-8.5, 0, -22),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-5.5, 0, -14),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-2.2, 0, -7),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-1.2, 0, 0),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-3.2, 0, 7.5),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      new THREE.Vector3(-6.2, 0, 15),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
