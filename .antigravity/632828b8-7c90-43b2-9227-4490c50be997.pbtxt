    instruction: "Implement Toy-Town Claymorphism trees, detailed buildings with dormers, windows, awnings, chimneys and stylized pastel landmark models."
    replacement_infos {
      original_chunk {
        target_content: "    // 8. Ronda del Sin\303\272 (Green Linear Park along Riverbank)\n    const rondaGroup = new THREE.Group();\n\n    // Helper: Low-Poly Palm Tree\n    const createPalmTree = (x: number, z: number) => {\n      const palmGroup = new THREE.Group();\n      const trunkGeo = new THREE.CylinderGeometry(0.08, 0.14, 1.8, 5);\n      const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n      trunk.position.y = 0.9;\n      trunk.rotation.z = (Math.random() - 0.5) * 0.15;\n      trunk.castShadow = true;\n      palmGroup.add(trunk);\n\n      // Fronds (Low-poly flat fan leaves)\n      for (let f = 0; f < 6; f++) {\n        const frondAngle = (f / 6) * Math.PI * 2;\n        const frondGeo = new THREE.ConeGeometry(0.35, 1.1, 4);\n        const frond = new THREE.Mesh(frondGeo, palmFrondMat);\n        frond.position.set(Math.cos(frondAngle) * 0.3, 1.8, Math.sin(frondAngle) * 0.3);\n        frond.rotation.x = Math.PI / 2.8;\n        frond.rotation.y = frondAngle;\n        frond.scale.set(1, 0.2, 1);\n        frond.castShadow = true;\n        palmGroup.add(frond);\n      }\n      palmGroup.position.set(x, -0.45, z);\n      return palmGroup;\n    };\n\n    // Helper: Low-Poly Tropical Guayac\303\241n / Canopy Tree\n    const createCanopyTree = (x: number, z: number, isGuayacan = false) => {\n      const treeGroup = new THREE.Group();\n      const trunkGeo = new THREE.CylinderGeometry(0.12, 0.18, 1.2, 5);\n      const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n      trunk.position.y = 0.6;\n      trunk.castShadow = true;\n      treeGroup.add(trunk);\n\n      const crownGeo = new THREE.DodecahedronGeometry(0.7, 0);\n      const crownMat = isGuayacan ? foliageGuayacanMat : foliageGreenMat;\n      const crown = new THREE.Mesh(crownGeo, crownMat);\n      crown.position.y = 1.6;\n      crown.scale.set(1.1, 0.9, 1.1);\n      crown.castShadow = true;\n      treeGroup.add(crown);\n\n      treeGroup.position.set(x, -0.45, z);\n      return treeGroup;\n    };\n\n    // Populate Ronda del Sin\303\272 along river curves\n    for (let i = 0; i <= 48; i++) {\n      const t = i / 48;\n      const pt = riverCurve.getPoint(t);\n      // East riverbank park (Ronda del Sin\303\272)\n      const eastOffset = 3.2 + (i % 3 === 0 ? 0.6 : -0.3);\n      if (i % 2 === 0) {\n        rondaGroup.add(createPalmTree(pt.x + eastOffset, pt.z));\n      } else {\n        rondaGroup.add(createCanopyTree(pt.x + eastOffset, pt.z, i % 5 === 0));\n      }\n\n      // West riverbank vegetation\n      if (i % 3 === 0) {\n        const westOffset = -3.2 + (Math.random() - 0.5) * 0.4;\n        rondaGroup.add(createCanopyTree(pt.x + westOffset, pt.z, i % 7 === 0));\n      }\n    }\n    scene.add(rondaGroup);\n\n    // 9. Procedural Low-Poly Buildings with Monter\303\255a Urban Diversity\n    const cityGroup = new THREE.Group();\n\n    // Helper to generate a single low-poly building with clay tile roof or rooftop terrace\n    const createBuilding = (\n      x: number,\n      z: number,\n      width: number,\n      depth: number,\n      floors: number,\n      style: \'colonial\' | \'townhouse\' | \'midrise\'\n    ) => {\n      const bGroup = new THREE.Group();\n      const floorHeight = 0.65;\n      const totalH = floors * floorHeight;\n\n      const wallMat = wallMaterials[Math.floor(Math.random() * wallMaterials.length)];\n      const roofMat = roofMaterials[Math.floor(Math.random() * roofMaterials.length)];\n\n      // 1. Base Wall Body\n      const bodyGeo = new THREE.BoxGeometry(width, totalH, depth);\n      const bodyMesh = new THREE.Mesh(bodyGeo, wallMat);\n      bodyMesh.position.y = totalH / 2;\n      bodyMesh.castShadow = true;\n      bodyMesh.receiveShadow = true;\n      bGroup.add(bodyMesh);\n\n      // 2. Windows & Balconies (Subtle Low-poly Insets/Accents)\n      if (floors >= 2 && !isWire) {\n        for (let f = 1; f < floors; f++) {\n          const balconyGeo = new THREE.BoxGeometry(width * 0.7, 0.12, 0.15);\n          const balcony = new THREE.Mesh(balconyGeo, woodAccentMat);\n          balcony.position.set(0, f * floorHeight, depth / 2 + 0.08);\n          balcony.castShadow = true;\n          bGroup.add(balcony);\n        }\n      }\n\n      // 3. Roof Style\n      if (style === \'colonial\') {\n        // Traditional 4-sided pitched clay roof (Pyramid Hip Roof)\n        const roofHeight = 0.55 + width * 0.2;\n        const roofGeo = new THREE.ConeGeometry(Math.max(width, depth) * 0.78, roofHeight, 4);\n        const roofMesh = new THREE.Mesh(roofGeo, roofMat);\n        roofMesh.position.y = totalH + roofHeight / 2 - 0.05;\n        roofMesh.rotation.y = Math.PI / 4;\n        roofMesh.scale.set(width / Math.max(width, depth), 1, depth / Math.max(width, depth));\n        roofMesh.castShadow = true;\n        roofMesh.receiveShadow = true;\n        bGroup.add(roofMesh);\n      } else if (style === \'townhouse\') {\n        // Flat Roof with Parapet Perimeter + Elevated Water Tank (Tanque de Agua)\n        const parapetGeo = new THREE.BoxGeometry(width, 0.15, depth);\n        const parapet = new THREE.Mesh(parapetGeo, roofMat);\n        parapet.position.y = totalH + 0.075;\n        parapet.castShadow = true;\n        bGroup.add(parapet);\n\n        // Water tank / rooftop terrace box\n        const tankGeo = new THREE.CylinderGeometry(0.2, 0.2, 0.3, 6);\n        const tank = new THREE.Mesh(tankGeo, woodAccentMat);\n        tank.position.set((Math.random() - 0.5) * (width * 0.4), totalH + 0.25, (Math.random() - 0.5) * (depth * 0.4));\n        tank.castShadow = true;\n        bGroup.add(tank);\n      } else {\n        // Midrise Stepped Roof\n        const penthouseW = width * 0.65;\n        const penthouseD = depth * 0.65;\n        const penthouseH = 0.5;\n        const pentGeo = new THREE.BoxGeometry(penthouseW, penthouseH, penthouseD);\n        const pentMesh = new THREE.Mesh(pentGeo, wallMaterials[0]);\n        pentMesh.position.y = totalH + penthouseH / 2;\n        pentMesh.castShadow = true;\n        bGroup.add(pentMesh);\n\n        const topCapGeo = new THREE.BoxGeometry(penthouseW + 0.1, 0.1, penthouseD + 0.1);\n        const topCap = new THREE.Mesh(topCapGeo, roofMat);\n        topCap.position.y = totalH + penthouseH + 0.05;\n        bGroup.add(topCap);\n      }\n\n      bGroup.position.set(x, -0.38, z);\n      return bGroup;\n    };\n\n    // Populate each urban block with diverse low-poly houses & buildings\n    blocks.forEach((block) => {\n      const halfW = block.w / 2;\n      const halfD = block.d / 2;\n\n      // Subdivide block into 2 or 4 lots\n      const subdivisions = [\n        { ox: -halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: -halfW * 0.5, oz: halfD * 0.5 },\n        { ox: halfW * 0.5, oz: halfD * 0.5 },\n      ];\n\n      subdivisions.forEach((sub, idx) => {\n        const bX = block.x + sub.ox;\n        const bZ = block.z + sub.oz;\n        const lotW = 0.9 + Math.random() * 0.25;\n        const lotD = 0.9 + Math.random() * 0.25;\n\n        let floors = 1;\n        let style: \'colonial\' | \'townhouse\' | \'midrise\' = \'colonial\';\n\n        // Downtown (East Bank near center) has some taller 3-6 floor buildings\n        const distFromCenter = Math.sqrt(bX * bX + bZ * bZ);\n        if (block.isEast && distFromCenter < 9 && idx === 0 && Math.random() > 0.45) {\n          floors = Math.floor(3 + Math.random() * 3);\n          style = \'midrise\';\n        } else if (Math.random() > 0.4) {\n          floors = 2;\n          style = Math.random() > 0.5 ? \'colonial\' : \'townhouse\';\n        } else {\n          floors = 1;\n          style = \'colonial\';\n        }\n\n        cityGroup.add(createBuilding(bX, bZ, lotW, lotD, floors, style));\n      });\n    });\n\n    scene.add(cityGroup);\n\n    // 10. Iconic Monter\303\255a Landmark Models (Crafted in Low-Poly)\n    const landmarks3DGroup = new THREE.Group();\n\n    // A. Catedral San Jer\303\263nimo (Double Tower Neoclassical Cathedral in Plaza)\n    const catGroup = new THREE.Group();\n    const catWallMat = wallMaterials[0]; // Pure white stucco\n    const catRoofMat = roofMaterials[0]; // Terracotta clay roof\n    const catDomeMat = new THREE.MeshStandardMaterial({ color: 0xdeb04c, roughness: 0.6, metalness: 0.3 }); // Golden dome\n\n    // Central Nave\n    const naveGeo = new THREE.BoxGeometry(2.4, 2.2, 3.8);\n    const nave = new THREE.Mesh(naveGeo, catWallMat);\n    nave.position.y = 1.1;\n    nave.castShadow = true;\n    nave.receiveShadow = true;\n    catGroup.add(nave);\n\n    // Nave Gabled Roof\n    const naveRoofGeo = new THREE.ConeGeometry(2.2, 1.2, 4);\n    const naveRoof = new THREE.Mesh(naveRoofGeo, catRoofMat);\n    naveRoof.position.set(0, 2.8, 0);\n    naveRoof.rotation.y = Math.PI / 4;\n    naveRoof.scale.set(1, 1, 1.6);\n    naveRoof.castShadow = true;\n    catGroup.add(naveRoof);\n\n    // Twin Bell Towers (Front Facade)\n    [-1.0, 1.0].forEach((tx) => {\n      const towerBaseGeo = new THREE.BoxGeometry(0.9, 3.8, 0.9);\n      const tower = new THREE.Mesh(towerBaseGeo, catWallMat);\n      tower.position.set(tx, 1.9, 1.8);\n      tower.castShadow = true;\n      catGroup.add(tower);\n\n      // Tower Spire Cupola\n      const spireGeo = new THREE.ConeGeometry(0.65, 1.2, 6);\n      const spire = new THREE.Mesh(spireGeo, catDomeMat);\n      spire.position.set(tx, 4.4, 1.8);\n      spire.castShadow = true;\n      catGroup.add(spire);\n    });\n\n    // Central Cupola / Dome\n    const domeGeo = new THREE.SphereGeometry(0.7, 8, 6, 0, Math.PI * 2, 0, Math.PI / 2);\n    const dome = new THREE.Mesh(domeGeo, catDomeMat);\n    dome.position.set(0, 3.2, -0.8);\n    dome.castShadow = true;\n    catGroup.add(dome);\n\n    catGroup.position.set(3.2, -0.4, 2.0);\n    landmarks3DGroup.add(catGroup);\n\n    // B. Muelle Tur\303\255stico & Planchones Tradicionales\n    const muelleGroup = new THREE.Group();\n    // Wooden Boardwalk Pier\n    const pierBoardGeo = new THREE.BoxGeometry(2.4, 0.15, 1.2);\n    const pierBoard = new THREE.Mesh(pierBoardGeo, woodAccentMat);\n    pierBoard.position.set(0, 0.1, 0);\n    pierBoard.castShadow = true;\n    muelleGroup.add(pierBoard);\n\n    // Planch\303\263n del Sin\303\272 (Traditional wooden cable boat with canvas roof)\n    const planchonBoatGeo = new THREE.BoxGeometry(1.4, 0.25, 0.8);\n    const planchonBoat = new THREE.Mesh(planchonBoatGeo, woodAccentMat);\n    planchonBoat.position.set(-1.6, -0.05, 0.3);\n    planchonBoat.castShadow = true;\n    muelleGroup.add(planchonBoat);\n\n    const canopyGeo = new THREE.BoxGeometry(1.4, 0.05, 0.8);\n    const canopyMat = new THREE.MeshStandardMaterial({ color: 0xfffaea, roughness: 0.9 });\n    const canopy = new THREE.Mesh(canopyGeo, canopyMat);\n    canopy.position.set(-1.6, 0.45, 0.3);\n    canopy.castShadow = true;\n    muelleGroup.add(canopy);\n\n    muelleGroup.position.set(-3.8, -0.4, -3.2);\n    landmarks3DGroup.add(muelleGroup);\n\n    // D. Monumento al Porro (Roundabout with Musical Low-Poly Brass Sculpture)\n    const porroGroup = new THREE.Group();\n    const roundaboutGeo = new THREE.CylinderGeometry(1.2, 1.3, 0.2, 16);\n    const roundabout = new THREE.Mesh(roundaboutGeo, sidewalkMat);\n    roundabout.position.y = 0.1;\n    roundabout.receiveShadow = true;\n    porroGroup.add(roundabout);\n\n    // Spiral Brass Horn / Porro notes abstract sculpture\n    const brassMat = new THREE.MeshStandardMaterial({ color: 0xe5a928, roughness: 0.3, metalness: 0.85 });\n    const hornGeo = new THREE.TorusGeometry(0.6, 0.12, 8, 16, Math.PI * 1.5);\n    const horn = new THREE.Mesh(hornGeo, brassMat);\n    horn.position.set(0, 0.9, 0);\n    horn.rotation.x = Math.PI / 3;\n    horn.castShadow = true;\n    porroGroup.add(horn);\n\n    const baseColumnGeo = new THREE.CylinderGeometry(0.18, 0.25, 0.8, 8);\n    const baseColumn = new THREE.Mesh(baseColumnGeo, catWallMat);\n    baseColumn.position.y = 0.4;\n    porroGroup.add(baseColumn);\n\n    porroGroup.position.set(5.2, -0.4, -4.2);\n    landmarks3DGroup.add(porroGroup);\n\n    scene.add(landmarks3DGroup);"
        replacement_content: "    // 8. Ronda del Sin\303\272 - Stylized Toy Trees & Fluffy Flora\n    const rondaGroup = new THREE.Group();\n\n    // Helper: Cute Fluffy Spherical / Cloud Toy Tree\n    const createFluffyToyTree = (x: number, z: number, colorType: \'green\' | \'lime\' | \'yellow\' | \'palm\') => {\n      const treeGroup = new THREE.Group();\n\n      if (colorType === \'palm\') {\n        // Cute Stylized Toy Palm Tree\n        const trunkCurve = (Math.random() - 0.5) * 0.15;\n        const trunkGeo = new THREE.CylinderGeometry(0.08, 0.15, 1.8, 8);\n        const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n        trunk.position.y = 0.9;\n        trunk.rotation.z = trunkCurve;\n        trunk.castShadow = true;\n        treeGroup.add(trunk);\n\n        // 6 Smooth Leaf Fronds (overlapping toy clay leaves)\n        for (let f = 0; f < 6; f++) {\n          const frondAngle = (f / 6) * Math.PI * 2;\n          const frondGeo = new THREE.ConeGeometry(0.38, 1.2, 5);\n          const frond = new THREE.Mesh(frondGeo, foliageLimePastelMat);\n          frond.position.set(Math.cos(frondAngle) * 0.35, 1.85, Math.sin(frondAngle) * 0.35);\n          frond.rotation.x = Math.PI / 2.7;\n          frond.rotation.y = frondAngle;\n          frond.scale.set(1, 0.25, 1);\n          frond.castShadow = true;\n          treeGroup.add(frond);\n        }\n      } else {\n        // Fluffy Cloud / Multi-Sphere Toy Tree (Lollipop/Bramble Clay Style)\n        const trunkGeo = new THREE.CylinderGeometry(0.1, 0.16, 1.2, 8);\n        const trunk = new THREE.Mesh(trunkGeo, treeTrunkMat);\n        trunk.position.y = 0.6;\n        trunk.castShadow = true;\n        treeGroup.add(trunk);\n\n        const crownMat =\n          colorType === \'lime\'\n            ? foliageLimePastelMat\n            : colorType === \'yellow\'\n            ? foliageGuayacanYellowMat\n            : foliageVibrantGreenMat;\n\n        // Central main sphere\n        const mainSphereGeo = new THREE.IcosahedronGeometry(0.7, 2);\n        const mainSphere = new THREE.Mesh(mainSphereGeo, crownMat);\n        mainSphere.position.y = 1.6;\n        mainSphere.castShadow = true;\n        treeGroup.add(mainSphere);\n\n        // 3 Cute overlapping puff clusters for fluffy clay volume\n        const puffOffsets = [\n          { x: 0.3, y: 1.45, z: 0.2, s: 0.45 },\n          { x: -0.28, y: 1.5, z: -0.25, s: 0.42 },\n          { x: 0.05, y: 1.95, z: -0.1, s: 0.48 },\n        ];\n\n        const subSphereGeo = new THREE.IcosahedronGeometry(1, 2);\n        puffOffsets.forEach((po) => {\n          const puff = new THREE.Mesh(subSphereGeo, crownMat);\n          puff.position.set(po.x, po.y, po.z);\n          puff.scale.set(po.s, po.s, po.s);\n          puff.castShadow = true;\n          treeGroup.add(puff);\n        });\n      }\n\n      treeGroup.position.set(x, -0.46, z);\n      return treeGroup;\n    };\n\n    // Helper: Cute Mini Bush / Shrub\n    const createToyBush = (x: number, z: number, s = 0.28) => {\n      const bushGeo = new THREE.IcosahedronGeometry(s, 2);\n      const bush = new THREE.Mesh(bushGeo, foliageLimePastelMat);\n      bush.position.set(x, -0.46 + s * 0.8, z);\n      bush.castShadow = true;\n      return bush;\n    };\n\n    // Populate Ronda del Sin\303\272 along river curves with diverse toy flora\n    for (let i = 0; i <= 48; i++) {\n      const t = i / 48;\n      const pt = riverCurve.getPoint(t);\n      // East riverbank park (Ronda del Sin\303\272)\n      const eastOffset = 3.2 + (i % 3 === 0 ? 0.6 : -0.3);\n      const colorKind: \'green\' | \'lime\' | \'yellow\' | \'palm\' =\n        i % 4 === 0 ? \'yellow\' : i % 3 === 0 ? \'palm\' : i % 2 === 0 ? \'lime\' : \'green\';\n      rondaGroup.add(createFluffyToyTree(pt.x + eastOffset, pt.z, colorKind));\n\n      // Cute roadside bushes\n      if (i % 2 === 0) {\n        rondaGroup.add(createToyBush(pt.x + eastOffset - 0.7, pt.z + 0.3));\n        rondaGroup.add(createToyBush(pt.x + eastOffset + 0.6, pt.z - 0.4, 0.22));\n      }\n\n      // West riverbank flora\n      if (i % 3 === 0) {\n        const westOffset = -3.2 + (Math.random() - 0.5) * 0.4;\n        rondaGroup.add(\n          createFluffyToyTree(\n            pt.x + westOffset,\n            pt.z,\n            i % 6 === 0 ? \'yellow\' : i % 2 === 0 ? \'green\' : \'lime\'\n          )\n        );\n      }\n    }\n    scene.add(rondaGroup);\n\n    // 9. Procedural Isometric Toy-Town Buildings with Dormers, Windows & Awnings\n    const cityGroup = new THREE.Group();\n\n    // Helper: Create single window frame with mullions\n    const createFramedWindow = (w = 0.26, h = 0.32) => {\n      const winGroup = new THREE.Group();\n      // White Outer Frame\n      const frameGeo = new THREE.BoxGeometry(w + 0.04, h + 0.04, 0.04);\n      const frame = new THREE.Mesh(frameGeo, windowFrameMat);\n      winGroup.add(frame);\n\n      // Inset Glass Pane\n      const glassGeo = new THREE.BoxGeometry(w, h, 0.05);\n      const glass = new THREE.Mesh(glassGeo, windowGlassMat);\n      winGroup.add(glass);\n\n      // White Mullions (Crossbars)\n      const vertBarGeo = new THREE.BoxGeometry(0.02, h, 0.055);\n      const vertBar = new THREE.Mesh(vertBarGeo, windowFrameMat);\n      winGroup.add(vertBar);\n\n      const horizBarGeo = new THREE.BoxGeometry(w, 0.02, 0.055);\n      const horizBar = new THREE.Mesh(horizBarGeo, windowFrameMat);\n      winGroup.add(horizBar);\n\n      return winGroup;\n    };\n\n    // Helper: Create striped storefront awning\n    const createAwning = (w = 0.6, d = 0.25) => {\n      const awnGroup = new THREE.Group();\n      const numStripes = 4;\n      const stripeW = w / numStripes;\n      for (let s = 0; s < numStripes; s++) {\n        const sGeo = new THREE.BoxGeometry(stripeW, 0.04, d);\n        const sMesh = new THREE.Mesh(sGeo, s % 2 === 0 ? awningMatRed : awningMatWhite);\n        sMesh.position.set(-w / 2 + stripeW / 2 + s * stripeW, 0, d / 2);\n        sMesh.rotation.x = Math.PI / 8;\n        sMesh.castShadow = true;\n        awnGroup.add(sMesh);\n      }\n      return awnGroup;\n    };\n\n    // Helper: Create a Roof Dormer Window (Buhardilla)\n    const createRoofDormer = (roofMat: THREE.MeshStandardMaterial) => {\n      const dormerGroup = new THREE.Group();\n      const dWidth = 0.26;\n      const dHeight = 0.28;\n      const dDepth = 0.32;\n\n      // Dormer Body Box\n      const dBodyGeo = new THREE.BoxGeometry(dWidth, dHeight, dDepth);\n      const dBody = new THREE.Mesh(dBodyGeo, facadeMaterials[0]);\n      dBody.castShadow = true;\n      dormerGroup.add(dBody);\n\n      // Dormer Pitched Mini Roof\n      const dRoofGeo = new THREE.ConeGeometry(dWidth * 0.75, 0.18, 4);\n      const dRoof = new THREE.Mesh(dRoofGeo, roofMat);\n      dRoof.position.y = dHeight / 2 + 0.09;\n      dRoof.rotation.y = Math.PI / 4;\n      dRoof.castShadow = true;\n      dormerGroup.add(dRoof);\n\n      // Dormer Front Window\n      const dWin = createFramedWindow(0.18, 0.2);\n      dWin.position.set(0, 0, dDepth / 2 + 0.02);\n      dormerGroup.add(dWin);\n\n      return dormerGroup;\n    };\n\n    // Generator for Toy-Town Claymorphism House / Boutique Building\n    const createToyBuilding = (\n      x: number,\n      z: number,\n      width: number,\n      depth: number,\n      floors: number,\n      style: \'gabled\' | \'mansard\' | \'townhouse\' | \'boutique\'\n    ) => {\n      const bGroup = new THREE.Group();\n      const floorHeight = 0.7;\n      const totalH = floors * floorHeight;\n\n      const wallMat = facadeMaterials[Math.floor(Math.random() * facadeMaterials.length)];\n      const roofMat = roofMaterials[Math.floor(Math.random() * roofMaterials.length)];\n\n      // 1. Base Wall Body with Smooth Toy Volume\n      const bodyGeo = new THREE.BoxGeometry(width, totalH, depth);\n      const bodyMesh = new THREE.Mesh(bodyGeo, wallMat);\n      bodyMesh.position.y = totalH / 2;\n      bodyMesh.castShadow = true;\n      bodyMesh.receiveShadow = true;\n      bGroup.add(bodyMesh);\n\n      // 2. Baseboard / Plinth Trim\n      const plinthGeo = new THREE.BoxGeometry(width + 0.04, 0.08, depth + 0.04);\n      const plinth = new THREE.Mesh(plinthGeo, roadCurbMat);\n      plinth.position.y = 0.04;\n      plinth.castShadow = true;\n      bGroup.add(plinth);\n\n      // 3. Facade Windows & Doors on Front (+z) & Back (-z)\n      const numWindowCols = width > 1.1 ? 2 : 1;\n      for (let f = 0; f < floors; f++) {\n        const floorY = f * floorHeight + floorHeight / 2;\n\n        for (let col = 0; col < numWindowCols; col++) {\n          const colX = numWindowCols === 2 ? (col === 0 ? -width * 0.25 : width * 0.25) : 0;\n\n          // Ground floor front door + window combo OR regular window\n          if (f === 0 && col === 0 && width > 0.8) {\n            // Front Entrance Door\n            const doorGeo = new THREE.BoxGeometry(0.24, 0.44, 0.04);\n            const door = new THREE.Mesh(doorGeo, doorWoodMat);\n            door.position.set(colX, 0.22, depth / 2 + 0.02);\n            door.castShadow = true;\n            bGroup.add(door);\n\n            // Little awning above door\n            if (Math.random() > 0.4) {\n              const doorAwning = createAwning(0.36, 0.18);\n              doorAwning.position.set(colX, 0.48, depth / 2 + 0.02);\n              bGroup.add(doorAwning);\n            }\n          } else {\n            // Standard Framed Window (Front)\n            const winFront = createFramedWindow(0.22, 0.28);\n            winFront.position.set(colX, floorY, depth / 2 + 0.02);\n            bGroup.add(winFront);\n          }\n\n          // Back Window\n          const winBack = createFramedWindow(0.22, 0.28);\n          winBack.position.set(colX, floorY, -depth / 2 - 0.02);\n          winBack.rotation.y = Math.PI;\n          bGroup.add(winBack);\n        }\n      }\n\n      // 4. Roof Style with Toy-Town Dormers & Chimneys\n      if (style === \'gabled\' || style === \'mansard\') {\n        // High-Pitched Coral/Terracotta Roof\n        const roofH = 0.55 + width * 0.18;\n        const roofGeo = new THREE.ConeGeometry(Math.max(width, depth) * 0.78, roofH, 4);\n        const roofMesh = new THREE.Mesh(roofGeo, roofMat);\n        roofMesh.position.y = totalH + roofH / 2 - 0.02;\n        roofMesh.rotation.y = Math.PI / 4;\n        roofMesh.scale.set((width + 0.1) / Math.max(width, depth), 1, (depth + 0.1) / Math.max(width, depth));\n        roofMesh.castShadow = true;\n        roofMesh.receiveShadow = true;\n        bGroup.add(roofMesh);\n\n        // Roof Dormer Windows (Buhardillas) on front slope!\n        if (width >= 0.95 && Math.random() > 0.3) {\n          const dormer = createRoofDormer(roofMat);\n          dormer.position.set(0, totalH + roofH * 0.35, depth * 0.3);\n          bGroup.add(dormer);\n        }\n\n        // Cute Clay Chimney with White Cap\n        if (Math.random() > 0.45) {\n          const chimW = 0.14;\n          const chimH = 0.45;\n          const chimGeo = new THREE.BoxGeometry(chimW, chimH, chimW);\n          const chimMesh = new THREE.Mesh(chimGeo, roofMat);\n          chimMesh.position.set(width * 0.28, totalH + roofH * 0.6, -depth * 0.15);\n          chimMesh.castShadow = true;\n          bGroup.add(chimMesh);\n\n          // Chimney Cap\n          const capGeo = new THREE.BoxGeometry(chimW + 0.05, 0.04, chimW + 0.05);\n          const cap = new THREE.Mesh(capGeo, chimneyCapMat);\n          cap.position.set(width * 0.28, totalH + roofH * 0.6 + chimH / 2 + 0.02, -depth * 0.15);\n          bGroup.add(cap);\n        }\n      } else if (style === \'townhouse\') {\n        // Flat Roof with Raised Perimeter Parapet & Rooftop Terrace Pergola\n        const parapetGeo = new THREE.BoxGeometry(width + 0.08, 0.16, depth + 0.08);\n        const parapet = new THREE.Mesh(parapetGeo, roofMat);\n        parapet.position.y = totalH + 0.08;\n        parapet.castShadow = true;\n        bGroup.add(parapet);\n\n        // Mini rooftop garden box / planter\n        const planterGeo = new THREE.BoxGeometry(width * 0.5, 0.12, 0.25);\n        const planter = new THREE.Mesh(planterGeo, roadCurbMat);\n        planter.position.set(0, totalH + 0.1, depth * 0.25);\n        bGroup.add(planter);\n\n        const plantBush = createToyBush(0, depth * 0.25, 0.14);\n        plantBush.position.y = totalH + 0.22;\n        bGroup.add(plantBush);\n      } else {\n        // Boutique Multi-tier Stepped Roof with Penthouse\n        const pentW = width * 0.65;\n        const pentD = depth * 0.65;\n        const pentH = 0.55;\n        const pentGeo = new THREE.BoxGeometry(pentW, pentH, pentD);\n        const pent = new THREE.Mesh(pentGeo, facadeMaterials[0]);\n        pent.position.y = totalH + pentH / 2;\n        pent.castShadow = true;\n        bGroup.add(pent);\n\n        // Penthouse Roof\n        const pentRoofGeo = new THREE.ConeGeometry(Math.max(pentW, pentD) * 0.78, 0.38, 4);\n        const pentRoof = new THREE.Mesh(pentRoofGeo, roofMat);\n        pentRoof.position.y = totalH + pentH + 0.18;\n        pentRoof.rotation.y = Math.PI / 4;\n        pentRoof.castShadow = true;\n        bGroup.add(pentRoof);\n\n        // Penthouse Front Window\n        const pentWin = createFramedWindow(0.18, 0.22);\n        pentWin.position.set(0, totalH + pentH / 2, pentD / 2 + 0.02);\n        bGroup.add(pentWin);\n      }\n\n      bGroup.position.set(x, -0.38, z);\n      return bGroup;\n    };\n\n    // Populate each urban block with diverse Toy-Town miniature houses & buildings\n    blocks.forEach((block) => {\n      const halfW = block.w / 2;\n      const halfD = block.d / 2;\n\n      // Subdivide block into 4 distinct lots\n      const subdivisions = [\n        { ox: -halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: halfW * 0.5, oz: -halfD * 0.5 },\n        { ox: -halfW * 0.5, oz: halfD * 0.5 },\n        { ox: halfW * 0.5, oz: halfD * 0.5 },\n      ];\n\n      subdivisions.forEach((sub, idx) => {\n        const bX = block.x + sub.ox;\n        const bZ = block.z + sub.oz;\n        const lotW = 0.95 + Math.random() * 0.2;\n        const lotD = 0.95 + Math.random() * 0.2;\n\n        let floors = 1;\n        let style: \'gabled\' | \'mansard\' | \'townhouse\' | \'boutique\' = \'gabled\';\n\n        const distFromCenter = Math.sqrt(bX * bX + bZ * bZ);\n        if (block.isEast && distFromCenter < 9 && idx === 0 && Math.random() > 0.4) {\n          floors = Math.floor(3 + Math.random() * 2);\n          style = \'boutique\';\n        } else if (Math.random() > 0.45) {\n          floors = 2;\n          style = Math.random() > 0.5 ? \'mansard\' : \'townhouse\';\n        } else {\n          floors = 1;\n          style = \'gabled\';\n        }\n\n        cityGroup.add(createToyBuilding(bX, bZ, lotW, lotD, floors, style));\n      });\n    });\n\n    scene.add(cityGroup);\n\n    // 10. Iconic Monter\303\255a Landmark Models (Toy-Town Claymorphism Diorama Edition)\n    const landmarks3DGroup = new THREE.Group();\n\n    // A. Catedral San Jer\303\263nimo (Double Tower Neoclassical Cathedral in Toy Claymorphism)\n    const catGroup = new THREE.Group();\n    const catWallMat = facadeMaterials[0]; // Pure warm white clay\n    const catRoofMat = roofMaterials[0]; // Coral Terracotta clay roof\n    const catDomeMat = new THREE.MeshStandardMaterial({ color: 0xf5b722, roughness: 0.4, metalness: 0.4 }); // Golden dome\n\n    // Central Nave Body\n    const naveGeo = new THREE.BoxGeometry(2.4, 2.2, 3.8);\n    const nave = new THREE.Mesh(naveGeo, catWallMat);\n    nave.position.y = 1.1;\n    nave.castShadow = true;\n    nave.receiveShadow = true;\n    catGroup.add(nave);\n\n    // Front Grand Entrance Portal Stairs\n    const stairsGeo = new THREE.BoxGeometry(1.6, 0.16, 0.6);\n    const stairs = new THREE.Mesh(stairsGeo, sidewalkMat);\n    stairs.position.set(0, 0.08, 2.1);\n    stairs.castShadow = true;\n    catGroup.add(stairs);\n\n    // Grand Double Wooden Entrance Door\n    const catDoorGeo = new THREE.BoxGeometry(0.7, 1.1, 0.06);\n    const catDoor = new THREE.Mesh(catDoorGeo, doorWoodMat);\n    catDoor.position.set(0, 0.65, 1.93);\n    catDoor.castShadow = true;\n    catGroup.add(catDoor);\n\n    // Ornate Rose Window Relief on Front Facade\n    const roseGeo = new THREE.TorusGeometry(0.35, 0.06, 8, 16);\n    const rose = new THREE.Mesh(roseGeo, catDomeMat);\n    rose.position.set(0, 1.6, 1.93);\n    catGroup.add(rose);\n\n    // Nave Gabled Roof\n    const naveRoofGeo = new THREE.ConeGeometry(2.2, 1.2, 4);\n    const naveRoof = new THREE.Mesh(naveRoofGeo, catRoofMat);\n    naveRoof.position.set(0, 2.8, 0);\n    naveRoof.rotation.y = Math.PI / 4;\n    naveRoof.scale.set(1, 1, 1.6);\n    naveRoof.castShadow = true;\n    catGroup.add(naveRoof);\n\n    // Twin Bell Towers (Front Facade)\n    [-1.0, 1.0].forEach((tx) => {\n      const towerBaseGeo = new THREE.BoxGeometry(0.85, 3.8, 0.85);\n      const tower = new THREE.Mesh(towerBaseGeo, catWallMat);\n      tower.position.set(tx, 1.9, 1.8);\n      tower.castShadow = true;\n      catGroup.add(tower);\n\n      // Belfry Arched Openings on Tower Tops\n      const belfryWin = createFramedWindow(0.24, 0.35);\n      belfryWin.position.set(tx, 3.2, 2.25);\n      catGroup.add(belfryWin);\n\n      // Tower Spire Cupola\n      const spireGeo = new THREE.ConeGeometry(0.6, 1.2, 8);\n      const spire = new THREE.Mesh(spireGeo, catDomeMat);\n      spire.position.set(tx, 4.4, 1.8);\n      spire.castShadow = true;\n      catGroup.add(spire);\n    });\n\n    // Central Main Dome\n    const domeGeo = new THREE.SphereGeometry(0.7, 16, 12, 0, Math.PI * 2, 0, Math.PI / 2);\n    const dome = new THREE.Mesh(domeGeo, catDomeMat);\n    dome.position.set(0, 3.2, -0.8);\n    dome.castShadow = true;\n    catGroup.add(dome);\n\n    catGroup.position.set(3.2, -0.4, 2.0);\n    landmarks3DGroup.add(catGroup);\n\n    // B. Muelle Tur\303\255stico & Planchones Tradicionales (Toy Diorama Edition)\n    const muelleGroup = new THREE.Group();\n    // Wooden Boardwalk Pier\n    const pierBoardGeo = new THREE.BoxGeometry(2.4, 0.16, 1.2);\n    const pierBoard = new THREE.Mesh(pierBoardGeo, doorWoodMat);\n    pierBoard.position.set(0, 0.1, 0);\n    pierBoard.castShadow = true;\n    muelleGroup.add(pierBoard);\n\n    // Planch\303\263n del Sin\303\272 (Traditional wooden cable boat with striped canvas roof)\n    const planchonBoatGeo = new THREE.BoxGeometry(1.4, 0.25, 0.8);\n    const planchonBoat = new THREE.Mesh(planchonBoatGeo, doorWoodMat);\n    planchonBoat.position.set(-1.6, -0.05, 0.3);\n    planchonBoat.castShadow = true;\n    muelleGroup.add(planchonBoat);\n\n    // Striped Canvas Canopy\n    const pCanopy = createAwning(1.4, 0.8);\n    pCanopy.position.set(-1.6, 0.45, 0.3 - 0.4);\n    muelleGroup.add(pCanopy);\n\n    muelleGroup.position.set(-3.8, -0.4, -3.2);\n    landmarks3DGroup.add(muelleGroup);\n\n    // C. Monumento al Porro (Roundabout with Musical Low-Poly Brass Sculpture)\n    const porroGroup = new THREE.Group();\n    const roundaboutGeo = new THREE.CylinderGeometry(1.2, 1.3, 0.2, 24);\n    const roundabout = new THREE.Mesh(roundaboutGeo, sidewalkMat);\n    roundabout.position.y = 0.1;\n    roundabout.receiveShadow = true;\n    porroGroup.add(roundabout);\n\n    // Mini decorative topiary bushes around roundabout\n    for (let b = 0; b < 6; b++) {\n      const bAngle = (b / 6) * Math.PI * 2;\n      const rBush = createToyBush(Math.cos(bAngle) * 0.9, Math.sin(bAngle) * 0.9, 0.15);\n      rBush.position.y = 0.28;\n      porroGroup.add(rBush);\n    }\n\n    // Spiral Brass Horn / Porro notes abstract sculpture\n    const brassMat = new THREE.MeshStandardMaterial({ color: 0xf5b722, roughness: 0.35, metalness: 0.7 });\n    const hornGeo = new THREE.TorusGeometry(0.6, 0.12, 8, 24, Math.PI * 1.5);\n    const horn = new THREE.Mesh(hornGeo, brassMat);\n    horn.position.set(0, 0.9, 0);\n    horn.rotation.x = Math.PI / 3;\n    horn.castShadow = true;\n    porroGroup.add(horn);\n\n    const baseColumnGeo = new THREE.CylinderGeometry(0.18, 0.25, 0.8, 12);\n    const baseColumn = new THREE.Mesh(baseColumnGeo, catWallMat);\n    baseColumn.position.y = 0.4;\n    porroGroup.add(baseColumn);\n\n    porroGroup.position.set(5.2, -0.4, -4.2);\n    landmarks3DGroup.add(porroGroup);\n\n    scene.add(landmarks3DGroup);"
      }
      num_matches: 1
    }
  }
