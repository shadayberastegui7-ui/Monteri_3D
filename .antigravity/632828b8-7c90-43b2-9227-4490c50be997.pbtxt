    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { NavigationTab } from \'../types\';\n\ninterface HeaderProps {\n  activeTab: NavigationTab;\n  onTabChange: (tab: NavigationTab) => void;\n  onOpenInfo: () => void;\n}\n\nexport const Header: React.FC<HeaderProps> = ({ activeTab, onTabChange, onOpenInfo }) => {\n  const [isMenuOpen, setIsMenuOpen] = useState(false);\n\n  return (\n    <>\n      <header className=\"fixed top-0 w-full z-50 bg-[#fff9eb]/80 dark:bg-[#e9e2ce]/10 backdrop-blur-md border-b border-[#bec9c8]/30 flex justify-between items-center px-5 py-3\">\n        {/* Left Icon */}\n        <button\n          onClick={onOpenInfo}\n          className=\"flex items-center gap-2 text-[#3e4948] dark:text-[#e9e2ce] hover:text-[#ffc24b] transition-colors cursor-pointer active:scale-95 duration-150\"\n          title=\"Ver Informaci\303\263n de Monter\303\255a\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">architecture</span>\n          <span className=\"hidden sm:inline text-xs font-mono uppercase tracking-widest text-[#9ff1f0]\">\n            8.7479\302\260 N\n          </span>\n        </button>\n\n        {/* Center Title */}\n        <button\n          onClick={() => onTabChange(\'explorer\')}\n          className=\"font-cormorant text-2xl md:text-3xl text-[#005151] dark:text-[#9ff1f0] tracking-tight font-bold cursor-pointer hover:opacity-90 transition-opacity\"\n        >\n          MONTER\303\215A EN 3D\n        </button>\n\n        {/* Right Icon / Drawer Trigger */}\n        <button\n          onClick={() => setIsMenuOpen(!isMenuOpen)}\n          className=\"flex items-center gap-2 text-[#3e4948] dark:text-[#e9e2ce] hover:text-[#ffc24b] transition-colors cursor-pointer active:scale-95 duration-150\"\n          title=\"Men\303\272 de Opciones\"\n        >\n          <span className=\"material-symbols-outlined text-[24px]\">\n            {isMenuOpen ? \'close\' : \'menu\'}\n          </span>\n        </button>\n      </header>\n\n      {/* Slide-Down Quick Menu */}\n      {isMenuOpen && (\n        <div className=\"fixed top-[57px] left-0 w-full z-40 bg-[#0a0806]/95 backdrop-blur-xl border-b border-[#006b6b]/40 text-[#fff9eb] p-6 shadow-2xl animate-fade-in-up\">\n          <div className=\"max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4\">\n            <button\n              onClick={() => {\n                onTabChange(\'explorer\');\n                setIsMenuOpen(false);\n              }}\n              className={`p-4 rounded-xl border text-left transition-all ${\n                activeTab === \'explorer\'\n                  ? \'bg-[#006b6b] border-[#9ff1f0] text-white\'\n                  : \'bg-[#1e1c0f]/60 border-[#6e7979]/30 hover:border-[#ffc24b]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-2xl mb-1 text-[#ffc24b]\">\n                view_in_ar\n              </span>\n              <div className=\"font-bold text-sm\">Explorador 3D</div>\n              <div className=\"text-xs text-gray-300\">Recorrido e interacci\303\263n tridimensional</div>\n            </button>\n\n            <button\n              onClick={() => {\n                onTabChange(\'gallery\');\n                setIsMenuOpen(false);\n              }}\n              className={`p-4 rounded-xl border text-left transition-all ${\n                activeTab === \'gallery\'\n                  ? \'bg-[#006b6b] border-[#9ff1f0] text-white\'\n                  : \'bg-[#1e1c0f]/60 border-[#6e7979]/30 hover:border-[#ffc24b]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-2xl mb-1 text-[#ffc24b]\">\n                collections\n              </span>\n              <div className=\"font-bold text-sm\">Galer\303\255a Digital</div>\n              <div className=\"text-xs text-gray-300\">Colecci\303\263n fotogr\303\241fica de alta resoluci\303\263n</div>\n            </button>\n\n            <button\n              onClick={() => {\n                onTabChange(\'map\');\n                setIsMenuOpen(false);\n              }}\n              className={`p-4 rounded-xl border text-left transition-all ${\n                activeTab === \'map\'\n                  ? \'bg-[#006b6b] border-[#9ff1f0] text-white\'\n                  : \'bg-[#1e1c0f]/60 border-[#6e7979]/30 hover:border-[#ffc24b]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-2xl mb-1 text-[#ffc24b]\">map</span>\n              <div className=\"font-bold text-sm\">Mapa & Rutas</div>\n              <div className=\"text-xs text-gray-300\">Rutas del R\303\255o, Historia y Gastronom\303\255a</div>\n            </button>\n\n            <button\n              onClick={() => {\n                onTabChange(\'settings\');\n                setIsMenuOpen(false);\n              }}\n              className={`p-4 rounded-xl border text-left transition-all ${\n                activeTab === \'settings\'\n                  ? \'bg-[#006b6b] border-[#9ff1f0] text-white\'\n                  : \'bg-[#1e1c0f]/60 border-[#6e7979]/30 hover:border-[#ffc24b]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-2xl mb-1 text-[#ffc24b]\">\n                settings\n              </span>\n              <div className=\"font-bold text-sm\">Ajustes & Render</div>\n              <div className=\"text-xs text-gray-300\">Personalizaci\303\263n visual y audio del Sin\303\272</div>\n            </button>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    }
